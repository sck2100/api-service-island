      function onScenePointerDown(event){if(event.button!==0)return;cancelCameraFlight();pointerStart={id:event.pointerId,x:event.clientX,y:event.clientY};}
      function screenPoint(position,rect){const projected=position.clone().project(camera);if(projected.z<-1||projected.z>1)return null;return{x:rect.left+(projected.x+1)*rect.width/2,y:rect.top+(-projected.y+1)*rect.height/2};}
