          { id:'deployment-service', name:'部署控制', description:'協調版本發布與回復。', metrics:{ rpm:85, p95:416, availability:99.90 }, status:'maintenance', model:'control-hall' }
        ]},
        { id: 'observability', name: '監控觀測', axial: [-2, 0], color: '#ff87bd', services: [
          { id:'metrics-service', name:'指標中心', description:'彙整速度、流量與錯誤率。', metrics:{ rpm:28600, p95:37, availability:99.97 }, status:'healthy', model:'radar-tower' },
          { id:'log-service', name:'日誌中心', description:'集中保存服務運作紀錄。', metrics:{ rpm:31200, p95:49, availability:99.95 }, status:'healthy', model:'archive-house' },
          { id:'trace-service', name:'鏈路追蹤', description:'串起一次請求經過的所有服務。', metrics:{ rpm:17400, p95:63, availability:99.92 }, status:'warning', model:'route-station' },
          { id:'alert-service', name:'告警服務', description:'異常時通知維運人員。', metrics:{ rpm:120, p95:88, availability:99.98 }, status:'healthy', model:'signal-tower' },
          { id:'health-service', name:'健康檢查', description:'持續確認服務是否正常回應。', metrics:{ rpm:9800, p95:22, availability:99.99 }, status:'healthy', model:'clinic-pod' }
        ]}
      ],
      flows: [
        { id:'browse', name:'瀏覽商品', from:'api-gateway', to:'catalog-service', protocol:'HTTPS', rpm:7200, level:'核心', mode:'sync', payload:'商品查詢條件', actor:'查詢封包', walkers:10, speed:.68, accessory:'magnifier', badge:'json' },
        { id:'login', name:'會員登入', from:'api-gateway', to:'auth-service', protocol:'HTTPS', rpm:4100, level:'關鍵', mode:'sync', payload:'登入憑證', actor:'驗證封包', walkers:8, speed:.64, accessory:'lock', badge:'jwe' },
        { id:'checkout', name:'送出結帳', from:'checkout-service', to:'order-service', protocol:'gRPC', rpm:2100, level:'關鍵', mode:'sync', payload:'購物車快照', actor:'結帳封包', walkers:7, speed:.37, accessory:'shield', badge:'token' },
        { id:'charge', name:'交易請款', from:'order-service', to:'payment-service', protocol:'gRPC', rpm:1980, level:'關鍵', mode:'sync', payload:'付款授權', actor:'支付封包', walkers:6, speed:.35, accessory:'lock', badge:'jws' },
        { id:'quota', name:'配額檢查', from:'api-gateway', to:'quota-service', protocol:'gRPC', rpm:2050, level:'核心', mode:'sync', payload:'API 金鑰與用量', actor:'配額封包', walkers:9, speed:.66, accessory:'shield', badge:'json' },
        { id:'discover', name:'服務查詢', from:'order-service', to:'discovery-service', protocol:'gRPC', rpm:1560, level:'一般', mode:'sync', payload:'服務名稱與版本', actor:'查詢封包', walkers:5, speed:.34, accessory:'shield', badge:'token' },
        { id:'notify', name:'交易通知', from:'order-service', to:'notification-service', protocol:'Kafka', rpm:3600, level:'一般', mode:'async', payload:'通知內容', actor:'訊息事件', walkers:7, speed:.38, accessory:'magnifier', badge:'json' },
        { id:'telemetry', name:'觀測資料', from:'event-collector', to:'metrics-service', protocol:'OTLP', rpm:16800, level:'觀測', mode:'pending', payload:'追蹤與指標批次', actor:'遙測封包', walkers:12, speed:.70, accessory:'magnifier', badge:'json' },
        { id:'batch-report', name:'帳務報表批次', from:'order-service', to:'report-service', protocol:'Kafka', rpm:420, level:'批次', mode:'async', payload:'彙總帳務事件', actor:'報表批次封包', walkers:8, speed:.36, accessory:'shield', badge:'json' },
        { id:'mq-replay', name:'訊息佇列重送', from:'notification-service', to:'order-service', protocol:'Kafka', rpm:260, level:'批次', mode:'async', payload:'待處理訊息批次', actor:'佇列封包', walkers:7, speed:.36, accessory:'lock', badge:'jwe' }
      ],
      get apiFlows(){ return this.flows; },
      dayCycle: [
        { id:'dawn', label:'清晨', start:'05:00', highLoad:['scheduler','throttle-event'], flowLoad:{quota:1.1,discover:.8,telemetry:.9,'batch-report':1.0} },
        { id:'morning', label:'早晨', start:'07:00', highLoad:['auth-service','api-gateway','catalog-service','order-service'], flowLoad:{browse:2.3,login:2.2,checkout:1.7,charge:1.1,quota:1.0,discover:.55,notify:.65,telemetry:.8,'batch-report':.55,'mq-replay':.4} },
        { id:'noon', label:'正午', start:'11:00', highLoad:['search-index','cart-service','pricing-service'], flowLoad:{browse:1.0,login:.8,checkout:1.0,charge:.8,quota:.9,discover:.8,notify:.9,telemetry:1.0,'batch-report':.8,'mq-replay':.7} },
        { id:'afternoon', label:'午後', start:'14:00', highLoad:['order-service','checkout-service','payment-service','report-service'], flowLoad:{browse:.7,login:.65,checkout:2.2,charge:2.3,quota:1.7,discover:1.0,notify:1.1,telemetry:.9,'batch-report':1.8,'mq-replay':.65} },
        { id:'sunset', label:'黃昏', start:'17:00', highLoad:['discovery-service','service-mesh','notification-service'], flowLoad:{browse:.7,login:.6,checkout:1.0,charge:1.0,quota:.8,discover:2.2,notify:1.8,telemetry:1.0,'batch-report':1.0,'mq-replay':1.1} },
        { id:'evening', label:'晚間', start:'19:00', highLoad:['stream-processor','report-service','event-collector','notification-service','order-service'], flowLoad:{browse:.3,login:.35,checkout:.45,charge:.4,quota:.5,discover:.45,notify:2.2,telemetry:1.2,'batch-report':2.3,'mq-replay':2.3} },
        { id:'midnight', label:'深夜', start:'23:00', highLoad:['log-service','metrics-service','trace-service','report-service','notification-service'], flowLoad:{browse:.25,login:.25,checkout:.3,charge:.3,quota:.45,discover:.35,notify:1.9,telemetry:1.5,'batch-report':2.1,'mq-replay':2.2} },
        { id:'predawn', label:'夜盡', start:'03:00', highLoad:['deployment-service','health-service'], flowLoad:{browse:.35,login:.35,checkout:.4,charge:.4,quota:.7,discover:.5,notify:.7,telemetry:1.1,'batch-report':1.0,'mq-replay':.8} }
      ],
      lightKeyframes: [
        { minute:0, sky:'#020713', horizon:'#11233d', sun:'#6680a8', sunIntensity:0.02, hemiIntensity:0.10, fog:'#07131e', water:'#071b2b' },
        { minute:300, sky:'#15233d', horizon:'#f48a70', sun:'#ffb274', sunIntensity:0.55, hemiIntensity:0.32, fog:'#334c5e', water:'#17425b' },
        { minute:480, sky:'#5fb2c9', horizon:'#f6ead8', sun:'#fff0cc', sunIntensity:1.55, hemiIntensity:0.72, fog:'#c9d8c8', water:'#2f6f80' },
        { minute:720, sky:'#6dbcd0', horizon:'#fbf2e4', sun:'#fff6dc', sunIntensity:2.00, hemiIntensity:0.88, fog:'#d5e0cf', water:'#327787' },
        { minute:1020, sky:'#4f8fa8', horizon:'#ffc08c', sun:'#ffbd78', sunIntensity:1.00, hemiIntensity:0.55, fog:'#b4a894', water:'#2b6474' },
        { minute:1140, sky:'#18294a', horizon:'#f06f78', sun:'#ff8f77', sunIntensity:0.30, hemiIntensity:0.25, fog:'#35485b', water:'#12394e' },
        { minute:1320, sky:'#050a1b', horizon:'#172a47', sun:'#819bd0', sunIntensity:0.04, hemiIntensity:0.12, fog:'#0d1b29', water:'#081f31' },
        { minute:1440, sky:'#020713', horizon:'#11233d', sun:'#6680a8', sunIntensity:0.02, hemiIntensity:0.10, fog:'#07131e', water:'#071b2b' }
      ],
      english:{
        domains:{gateway:'Gateway',identity:'Identity',customer:'Customer',catalog:'Catalog',order:'Orders',payment:'Payments',traffic:'Traffic Control',registry:'Service Discovery',notification:'Notifications',analytics:'Analytics',platform:'Platform',observability:'Observability'},
        services:{
          'api-gateway':['API Gateway','Receives external requests and routes them.'],'rate-limiter':['Rate Limiter','Controls traffic bursts to prevent overload.'],waf:['Application Firewall','Blocks malicious or abnormal requests.'],'request-router':['Request Router','Routes requests to the correct system.'],
          'auth-service':['Sign-in Service','Validates credentials and sign-in flows.'],'token-service':['Token Center','Issues and refreshes access tokens.'],'permission-service':['Permission Service','Determines which actions a user may perform.'],'profile-service':['Account Profile','Stores account details and preferences.'],
          'customer-service':['Customer Service','Manages customer records and contact details.'],'preference-service':['Preferences','Stores notification, language, and personalization choices.'],'segment-service':['Customer Segments','Groups customers into useful audiences.'],'support-service':['Support Cases','Tracks questions, replies, and resolution progress.'],
          'catalog-service':['Product Catalog','Provides product names, categories, and availability.'],'pricing-service':['Pricing Service','Calculates prices, discounts, and regional pricing.'],'search-index':['Search Index','Makes products quick to find.'],'media-metadata':['Media Metadata','Manages product-media descriptions and ordering.'],
          'order-service':['Order Service','Creates and tracks every order.'],'cart-service':['Shopping Cart','Temporarily holds selected products.'],'checkout-service':['Checkout Service','Coordinates pricing, inventory, and payment.'],'order-history':['Order History','Provides past orders and status queries.'],
          'payment-service':['Payment Service','Coordinates cards and alternative payments.'],'fraud-service':['Risk Detection','Detects suspicious transactions in real time.'],'refund-service':['Refund Service','Processes refunds to the original method.'],'ledger-service':['Transaction Ledger','Keeps auditable payment records.'],
          'traffic-policy':['Traffic Policy','Defines rate-limit rules by client, path, and plan.'],'quota-service':['Quota Service','Tracks the daily usage quota of each API key.'],'circuit-breaker':['Circuit Breaker','Pauses forwarding when downstream fails, then recovers automatically.'],'throttle-event':['Throttle Events','Publishes over-limit, block, and release events.'],
          'discovery-service':['Discovery Service','Resolves available instances by name, version, and region.'],'health-checker':['Health Checker','Probes instances and removes unhealthy nodes.'],'config-center':['Config Center','Publishes service settings and feature flags centrally.'],'service-mesh':['Service Mesh','Handles encryption, retries, and traffic splitting between services.'],
          'notification-service':['Notification Center','Chooses when and how to notify.'],'email-service':['Email Service','Sends transactional and campaign emails.'],'sms-service':['SMS Service','Sends alerts and verification codes.'],'push-service':['Push Service','Sends updates to phones and browsers.'],
          'event-collector':['Event Collector','Receives behavior events from every system.'],'stream-processor':['Stream Processor','Processes continuous data in real time.'],'report-service':['Report Service','Produces operational metrics and trend reports.'],'feature-store':['Feature Store','Stores shared analytics and model features.'],
          'config-service':['Configuration Center','Provides centralized environment configuration.'],'service-registry':['Service Registry','Records available locations for each service.'],scheduler:['Scheduler','Starts routine background work on time.'],'secret-service':['Secret Vault','Securely provides keys and sensitive settings.'],'deployment-service':['Deployment Control','Coordinates releases and rollbacks.'],
          'metrics-service':['Metrics Center','Aggregates latency, traffic, and error rates.'],'log-service':['Log Center','Stores service operating records.'],'trace-service':['Distributed Tracing','Connects every service in a request journey.'],'alert-service':['Alert Service','Notifies operators when anomalies occur.'],'health-service':['Health Checks','Continuously verifies service responses.']
        },
        flows:{browse:['Browse products','Product query','Query packet','Core'],login:['Member sign-in','Credentials','Validation packet','Critical'],checkout:['Submit checkout','Cart snapshot','Checkout packet','Critical'],charge:['Authorize charge','Payment authorization','Payment packet','Critical'],quota:['Quota check','API key and usage','Quota packet','Core'],discover:['Service lookup','Service name and version','Lookup packet','General'],notify:['Transaction notification','Notification content','Message event','General'],telemetry:['Telemetry data','Trace and metrics batch','Telemetry packet','Observability'],'batch-report':['Accounting report batch','Aggregated accounting events','Report batch packet','Batch'],'mq-replay':['Message queue replay','Pending message batch','Queue packet','Batch']},
        periods:{dawn:'Dawn',morning:'Morning',noon:'Noon',afternoon:'Afternoon',sunset:'Sunset',evening:'Evening',midnight:'Late night',predawn:'Before dawn'}
      }
    };

    const statusEl = document.querySelector('#status');
    const statusTitle = document.querySelector('#status-title');
    const statusMessage = document.querySelector('#status-message');
    const clockEl = document.querySelector('#clock');
    const container = document.querySelector('#scene');
    const UI_LANG = new URLSearchParams(location.search).get('lang')?.toLowerCase()==='en'?'en':'zh';
    const tr = key => DATA.i18n[UI_LANG]?.[key] ?? DATA.i18n.zh[key] ?? key;
    const localize = (item,key='name') => UI_LANG==='en' ? (item[`${key}En`] ?? item[key]) : item[key];
    DATA.domains.forEach(domain=>{domain.nameEn=DATA.english.domains[domain.id]||domain.name;domain.services.forEach(service=>{const translated=DATA.english.services[service.id];service.nameEn=translated?.[0]||service.name;service.descriptionEn=translated?.[1]||service.description;});});
    DATA.flows.forEach(flow=>{const translated=DATA.english.flows[flow.id];flow.nameEn=translated?.[0]||flow.name;flow.payloadEn=translated?.[1]||flow.payload;flow.actorEn=translated?.[2]||flow.actor;flow.levelEn=translated?.[3]||flow.level;});
    DATA.dayCycle.forEach(period=>period.labelEn=DATA.english.periods[period.id]||period.label);
    document.documentElement.lang=UI_LANG==='en'?'en':'zh-Hant';
    document.title=localize(DATA.city,'displayName');

    function applyStaticTranslations(){
      document.querySelector('#brand-title').textContent=localize(DATA.city,'displayName');document.querySelector('.brand__subtitle').textContent=localize(DATA.city);
      const text={overview:'overview',list:'list',help:'help',cityIndex:'cityIndex',domainsTab:'domainsTab',flowsTab:'flowsTab',cityTime:'cityTime',pause:'pause',bird:'bird',labels:'labels',packets:'packets',apiLines:'apiLines',logs:'logs',sync:'sync',async:'async',pending:'pending',systemLog:'systemLog',demoTraffic:'demoTraffic'};
      Object.entries(text).forEach(([id,key])=>{const el=document.querySelector(`[data-i18n="${id}"]`);if(!el)return;const target=el.matches('button')?el.querySelector('b')||el:el;target.textContent=tr(key);});
      const set=(selector,text,aria)=>{const el=document.querySelector(selector);if(!el)return;if(text!==null)el.textContent=text;if(aria)el.setAttribute('aria-label',aria);};
      set('.toolbar',null,tr('toolbar'));set('#overview-btn',null,tr('backOverview'));set('#list-btn',null,tr('openDirectory'));set('#help-btn',null,tr('showHelp'));
      set('#catalog-panel',null,tr('directory'));set('#catalog-close','×',`${tr('close')} ${tr('directory')}`);set('#detail-panel',null,tr('detail'));set('#detail-close','×',`${tr('close')} ${tr('detail')}`);set('#detail-back',`← ${tr('backList')}`);
      const search=document.querySelector('#catalog-search');search.placeholder=tr('search');search.setAttribute('aria-label',tr('search'));
      set('.hud',null,tr('controls'));set('#hud-toggle',null,tr('time'));document.querySelector('#hud-toggle b').textContent=tr('time');set('#log-filter',null,tr('filterFlow'));set('#log-close','×',`${tr('close')} ${tr('systemLog')}`);
      set('#help-close','×',`${tr('close')} ${tr('help')}`);set('#help-title',tr('tutorialTitle'));set('#tutorial-progress',null,tr('tutorialProgress'));set('#tutorial-prev',tr('previous'));set('#tutorial-skip',tr('skip'));set('#tutorial-next',tr('next'));
      set('#status-title',tr('loading'));set('#status-message',tr('loadingMessage'));set('#reload-btn',tr('reload'));
      document.querySelectorAll('.sheet-handle').forEach(handle=>{const label=handle.dataset.sheet==='catalog'?tr('directory'):tr('detail');handle.textContent=label;handle.setAttribute('aria-label',`${tr('expand')} ${label}`);});
    }
    applyStaticTranslations();

    function showError(title, error) {
      console.error(error);
      statusEl.classList.remove('is-hidden');
      statusEl.classList.add('is-error');
      statusTitle.textContent = title;
      statusMessage.textContent = error instanceof Error ? error.message : String(error);
      document.querySelector('#reload-btn').hidden=false;
    }
    document.querySelector('#reload-btn').addEventListener('click',()=>location.reload());
    window.addEventListener('error', event => showError(tr('sceneError'), event.error || event.message));
    window.addEventListener('unhandledrejection', event => { event.preventDefault(); showError(tr('loadIncomplete'), event.reason); });

    (async function start() {
      try {
        statusMessage.textContent = tr('loadingEngine');
        const [THREE, controlsModule, labelsModule] = await Promise.all([
          import('three'),
          import('three/addons/controls/OrbitControls.js'),
          import('three/addons/renderers/CSS2DRenderer.js')
        ]);
        init(THREE, controlsModule.OrbitControls, labelsModule.CSS2DRenderer, labelsModule.CSS2DObject);
      } catch (error) {
        showError(tr('engineError'), new Error(tr('engineHint')+'\n' + (error?.message || error)));
      }
    })();

    function init(THREE, OrbitControls, CSS2DRenderer, CSS2DObject) {
      let renderer;
      try {
        renderer = new THREE.WebGLRenderer({ antialias:true, alpha:false, powerPreference:'high-performance' });
      } catch (error) {
        showError(tr('webglError'), new Error(tr('webglHint')+'\n' + error.message));
        return;
      }
      if (!renderer.getContext()) {
        showError(tr('webglError'), new Error(tr('webglHint')));
        return;
      }

      const reducedQuery = matchMedia('(prefers-reduced-motion: reduce)');
      let reducedMotion = reducedQuery.matches;
      const seed = 0xA91F5EED;
      const rng = mulberry32(seed);
      const artRng = mulberry32(DATA.artDirection.seed);
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0xc9d8c8, 0.0058);
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 500);
      const overviewData=DATA.stage3.overview;
      camera.position.set(...overviewData.target).add(new THREE.Vector3(...overviewData.direction).normalize().multiplyScalar(innerWidth/innerHeight<.9?overviewData.narrowDistance:overviewData.wideDistance));

      renderer.setPixelRatio(Math.min(devicePixelRatio, innerWidth <= DATA.stage5.mobileBreakpoint ? DATA.stage5.mobilePixelRatio : 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      container.appendChild(renderer.domElement);

      const labelRenderer = new CSS2DRenderer();
      labelRenderer.domElement.style.position = 'absolute';
      labelRenderer.domElement.style.inset = '0';
      labelRenderer.domElement.style.pointerEvents = 'none';
      container.appendChild(labelRenderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.set(...overviewData.target);
      controls.enableDamping = !reducedMotion;
      controls.dampingFactor = 0.055;
      controls.minDistance = 18;
      controls.maxDistance = overviewData.maxDistance;
      controls.maxPolarAngle = Math.PI * 0.465;
      const defaultMaxPolarAngle=controls.maxPolarAngle;
      const overviewDirection=camera.position.clone().sub(controls.target).normalize();

      const hemi = new THREE.HemisphereLight(0xd9eff0, 0x4b493c, 0.72);
      scene.add(hemi);
      const sun = new THREE.DirectionalLight(0xfff2cf, 1.55);
      sun.position.set(42, 68, -28);
      sun.castShadow = true;
      sun.shadow.mapSize.set(2048, 2048);
      sun.shadow.camera.left = sun.shadow.camera.bottom = -75;
      sun.shadow.camera.right = sun.shadow.camera.top = 75;
      sun.shadow.camera.near = 2;
      sun.shadow.camera.far = 180;
      sun.shadow.bias = -0.00035;
      sun.shadow.normalBias = 0.025;
      sun.shadow.radius = DATA.artDirection.shadowRadius;
      scene.add(sun, sun.target);
      const ambient = new THREE.AmbientLight(0xc8b99f, 0.22);
      scene.add(ambient);

      const skyUniforms = {
        topColor:{ value:new THREE.Color('#2389bb') }, bottomColor:{ value:new THREE.Color('#bdeeff') },
        sunColor:{ value:new THREE.Color('#fff2cf') }, sunDirection:{ value:new THREE.Vector3(0.5,0.7,-0.3).normalize() }
      };
      const sky = new THREE.Mesh(new THREE.SphereGeometry(260, 32, 18), new THREE.ShaderMaterial({
        side:THREE.BackSide, depthWrite:false, fog:false, uniforms:skyUniforms,
        vertexShader:`varying vec3 vWorld; void main(){ vec4 w=modelMatrix*vec4(position,1.0); vWorld=w.xyz; gl_Position=projectionMatrix*viewMatrix*w; }`,
        fragmentShader:`uniform vec3 topColor; uniform vec3 bottomColor; uniform vec3 sunColor; uniform vec3 sunDirection; varying vec3 vWorld; void main(){ vec3 d=normalize(vWorld-cameraPosition); float h=smoothstep(-0.12,0.82,d.y); float glow=pow(max(dot(d,sunDirection),0.0),180.0); vec3 c=mix(bottomColor,topColor,h)+sunColor*glow*1.3; gl_FragColor=vec4(c,1.0); }`
      }));
      scene.add(sky);

      const toyWater = DATA.environment.water;
      const waterUniforms = {
        uTime:{ value:0 }, uColor:{ value:new THREE.Color('#14728c') }, uFogColor:{ value:scene.fog.color },
        uFogDensity:{ value:scene.fog.density }, uSun:{ value:new THREE.Vector3(0.5,0.7,-0.3).normalize() },
        uNearColor:{ value:new THREE.Color(toyWater.near) }, uFarColor:{ value:new THREE.Color(toyWater.far) },
        uNearMix:{ value:toyWater.nearMix }, uFarMix:{ value:toyWater.farMix },
        uGradientRadius:{ value:new THREE.Vector2(...toyWater.gradientRadius) },
        uWaveAmp:{ value:new THREE.Vector3(...toyWater.waveAmplitude) },
        uWaveFreq:{ value:new THREE.Vector3(...toyWater.waveFrequency) },
        uWaveSpeed:{ value:new THREE.Vector3(...toyWater.waveSpeed) },
        uRippleContrast:{ value:toyWater.rippleContrast }, uDayMix:{ value:0 },
        uHorizonColor:{ value:skyUniforms.bottomColor.value }, uHorizonBlend:{ value:new THREE.Vector2(...toyWater.horizonBlend) }
      };
      const water = new THREE.Mesh(new THREE.PlaneGeometry(800, 800, 110, 110), new THREE.ShaderMaterial({
        transparent:false, uniforms:waterUniforms,
        vertexShader:`uniform float uTime; uniform vec3 uWaveAmp; uniform vec3 uWaveFreq; uniform vec3 uWaveSpeed; varying vec3 vWorld; varying float vWave; void main(){ vec3 p=position; float w=sin(p.x*uWaveFreq.x+uTime*uWaveSpeed.x)*uWaveAmp.x+cos(p.y*uWaveFreq.y-uTime*uWaveSpeed.y)*uWaveAmp.y+sin((p.x+p.y)*uWaveFreq.z+uTime*uWaveSpeed.z)*uWaveAmp.z; p.z+=w; vWave=w; vec4 world=modelMatrix*vec4(p,1.0); vWorld=world.xyz; gl_Position=projectionMatrix*viewMatrix*world; }`,
        fragmentShader:`uniform float uTime; uniform vec3 uColor; uniform vec3 uNearColor; uniform vec3 uFarColor; uniform vec3 uHorizonColor; uniform vec3 uFogColor; uniform float uNearMix; uniform float uFarMix; uniform float uDayMix; uniform float uRippleContrast; uniform float uFogDensity; uniform vec2 uGradientRadius; uniform vec2 uHorizonBlend; varying vec3 vWorld; varying float vWave; void main(){ float radius=length(vWorld.xz); float farWeight=smoothstep(uGradientRadius.x,uGradientRadius.y,radius); vec3 nearBase=mix(uColor,uNearColor,mix(.32,uNearMix,uDayMix)); vec3 farBase=mix(uColor,uFarColor,mix(.26,uFarMix,uDayMix)); vec3 c=mix(nearBase,farBase,farWeight); float broad=sin(vWorld.x*.052+vWorld.z*.038+uTime*.22); c+=broad*uRippleContrast*uDayMix+vWave*.03; c=mix(c,uHorizonColor,smoothstep(uHorizonBlend.x,uHorizonBlend.y,radius)); float dist=length(cameraPosition-vWorld); float fog=1.0-exp(-uFogDensity*uFogDensity*dist*dist); gl_FragColor=vec4(mix(c,uFogColor,clamp(fog,0.0,1.0)),1.0); }`
      }));
      water.rotation.x = -Math.PI / 2;
      water.position.y = -1.28;
      scene.add(water);

      const groundTexture = makeGroundTexture(THREE, rng);
      const patternTexture = makePatternTexture(THREE);
      const city = new THREE.Group();
      scene.add(city);
      const ISLAND_RADIUS = 9.2;
      const GRID_RADIUS = 11.25;
      const islandById = new Map();
      const coordMap = new Map();
      const roadGraph = new Map();
      const servicePositions = new Map();
      const serviceById = new Map(DATA.domains.flatMap(domain=>domain.services.map(service=>[service.id,service])));
      const domainByService = new Map(DATA.domains.flatMap(domain=>domain.services.map(service=>[service.id,domain])));
      const neighborDirs = [[1,0],[1,-1],[0,-1],[-1,0],[-1,1],[0,1]];
      const partBuckets = { static:[], near:[], glow:[] };
      const partOwners = { static:[], near:[], glow:[] };
      const serviceInstances = new Map();
      const instanceLookup = new WeakMap();
      const selectableServiceMeshes = [];
      const islandPickMeshes = [];
      const islandLabels = new Map();
      const servicePins = new Map();
      const servicePinLines = new Map();
      const flowRoutes = new Map();
      const flowMeshes = new Map();
      const flowPickMeshes = [];
      const walkers = [];
      const walkerById = new Map();
      const walkerInstanceLookup = new WeakMap();
      const walkerPickMeshes = [];
      const walkerLabels = new Map();
      const badgeResources = new Map();
      const nearMeshes = [];
      const nightMaterials = [];
      const silhouetteMaterials = [];
      let cloudField = null;
      let carField = null;
      let cloudMaterial = null;
      let stage2DrawCalls = 0;

      statusMessage.textContent = '生成 12 座島嶼、步道與跨島橋梁…';
      DATA.domains.forEach((domain, islandIndex) => {
        const [q,r] = domain.axial;
        const center = new THREE.Vector3(Math.sqrt(3)*GRID_RADIUS*(q+r/2), 0, 1.5*GRID_RADIUS*r);
        const vertices = Array.from({length:6}, (_, i) => {
          const angle = THREE.MathUtils.degToRad(30 + i*60);
          const radius = ISLAND_RADIUS * (0.92 + rng()*0.13);
          return new THREE.Vector2(Math.cos(angle)*radius, Math.sin(angle)*radius);
        });
        const group = new THREE.Group();
        group.position.copy(center);
        group.userData.domain = domain;
        city.add(group);
        createIsland(group, domain, vertices, islandIndex);
        const edgeMidpoints = Array.from({length:6}, (_, dir) => {
          const start = (5-dir+6)%6;
          return new THREE.Vector3((vertices[start].x+vertices[(start+1)%6].x)/2, .3, (vertices[start].y+vertices[(start+1)%6].y)/2).add(center);
        });
        islandById.set(domain.id, { domain, center, vertices, edgeMidpoints, group });
        coordMap.set(`${q},${r}`, domain.id);
        createRoadNodes(domain, center, edgeMidpoints);

        const label = document.createElement('div');
        label.className = 'island-label';
        label.textContent = localize(domain);
        label.dataset.full = localize(domain);
        label.dataset.short = localize(domain).slice(0,2);
        const labelObject = new CSS2DObject(label);
        labelObject.position.set(0, 4.35, 0);
        group.add(labelObject);
        islandLabels.set(domain.id,{element:label,object:labelObject});
      });

      const bridges = [];
      DATA.domains.forEach(domain => {
        const source = islandById.get(domain.id);
        neighborDirs.forEach((dir, dirIndex) => {
          const neighborId = coordMap.get(`${domain.axial[0]+dir[0]},${domain.axial[1]+dir[1]}`);
          if (!neighborId || domain.id.localeCompare(neighborId) >= 0) return;
          const target = islandById.get(neighborId);
          const opposite = (dirIndex + 3) % 6;
          createBridge(source.edgeMidpoints[dirIndex], target.edgeMidpoints[opposite], domain.id, neighborId);
          addGraphEdge(`${domain.id}:edge:${dirIndex}`, `${neighborId}:edge:${opposite}`);
        });
      });

      statusMessage.textContent = '組裝服務建物、街道家具與背景地形…';
      buildServiceModels();
      buildIslandFurniture();
      buildIslandDensity();
      buildEnvironment();
      createCars();
      instantiatePartLibrary();

      function createIsland(group, domain, vertices, index) {
        const art=domain.id===DATA.artDirection.showcase.domainId
          ? DATA.artDirection.showcase : DATA.artDirection.islandThemes[domain.id];
        const showcase=!!art;
        const shape = polygonShape(THREE, vertices);
        const wallGeo = new THREE.ExtrudeGeometry(shape, { depth:1.65, bevelEnabled:false, curveSegments:1 });
        wallGeo.rotateX(Math.PI/2);
        const wall = new THREE.Mesh(wallGeo, [
          new THREE.MeshStandardMaterial(showcase?{color:art.plaza,roughness:.96}:{ map:groundTexture, color:new THREE.Color(domain.color).lerp(new THREE.Color('#72906e'),.72), roughness:.93 }),
          new THREE.MeshStandardMaterial({ color:showcase?art.cliff:index%2 ? 0x34524c : 0x3d5d50, roughness:1 })
        ]);
        wall.position.y = .35;
        wall.receiveShadow = true;
        wall.castShadow = true;
        wall.userData.domainId=domain.id;
        islandPickMeshes.push(wall);
        group.add(wall);

        const shore=DATA.environment.shore;
        const shallow = ringMesh(vertices, 1.20, 0.18, new THREE.MeshBasicMaterial({ color:shore.shallow, transparent:true, opacity:shore.shallowOpacity, depthWrite:false }));
        shallow.position.y = -1.18;
        group.add(shallow);
        const softOutline = new THREE.CatmullRomCurve3(vertices.map(v=>new THREE.Vector3(v.x,v.y,0)),true,'centripetal').getPoints(48).slice(0,-1).map(v=>new THREE.Vector2(v.x,v.y));
        const foam = ringMesh(softOutline, shore.foamScale, shore.foamWidth, new THREE.MeshBasicMaterial({ color:shore.foam, transparent:true, opacity:shore.foamOpacity, depthWrite:false }));
        foam.position.y = -1.08;
        group.add(foam);

        const path = ringMesh(vertices, .71, .16, new THREE.MeshStandardMaterial({ color:showcase?art.path:0x8fa69f, roughness:.88 }));
        path.position.y = .43;
        path.receiveShadow = true;
        group.add(path);
        const pattern = ringMesh(vertices, .53, .07, new THREE.MeshStandardMaterial(showcase?{color:art.plazaInset,roughness:.9}:{ map:patternTexture, color:new THREE.Color(domain.color).lerp(new THREE.Color('#ffffff'),.36), roughness:.7 }));
        pattern.position.y = .455;
        group.add(pattern);

        const curbPoints = vertices.map(v => new THREE.Vector3(v.x*.79,.49,v.y*.79));
        curbPoints.push(curbPoints[0].clone());
        const curbCurve = new THREE.CatmullRomCurve3(curbPoints, true, 'centripetal', .15);
        const curb = new THREE.Mesh(new THREE.TubeGeometry(curbCurve, 72, .095, 5, true), new THREE.MeshStandardMaterial({ color:showcase?art.curb:0xc7d5cd, roughness:.75 }));
        curb.castShadow = true;
        group.add(curb);
      }

      function createRoadNodes(domain, center, edges) {
        const local = [];
        for (let i=0;i<6;i++) {
          const a = i*Math.PI/3;
          local.push(new THREE.Vector3(Math.cos(a)*4.4,.55,Math.sin(a)*4.4).add(center));
        }
        for (let i=0;i<6;i++) local.push(edges[i].clone().setY(.55));
        local.forEach((position, i) => roadGraph.set(`${domain.id}:${i<6?'ring':'edge'}:${i<6?i:i-6}`, { id:`${domain.id}:${i<6?'ring':'edge'}:${i<6?i:i-6}`, position, links:new Set() }));
        for (let i=0;i<6;i++) {
          addGraphEdge(`${domain.id}:ring:${i}`, `${domain.id}:ring:${(i+1)%6}`);
          addGraphEdge(`${domain.id}:ring:${i}`, `${domain.id}:edge:${i}`);
        }
      }

      function addGraphEdge(a,b) {
        const nodeA=roadGraph.get(a), nodeB=roadGraph.get(b);
        if (!nodeA || !nodeB) return;
        nodeA.links.add(b); nodeB.links.add(a);
      }

      function createBridge(a,b,from,to) {
        const mid = a.clone().add(b).multiplyScalar(.5);
        const length = a.distanceTo(b);
        const yaw = Math.atan2(b.x-a.x, b.z-a.z);
        const bridge = new THREE.Group();
        bridge.position.copy(mid);
        bridge.rotation.y = yaw;
        const deck = new THREE.Mesh(new THREE.BoxGeometry(2.15,.24,length+.35,1,1,10), new THREE.MeshStandardMaterial({ color:0xaebbb5, roughness:.78 }));
        deck.geometry.translate(0,0,0);
        deck.position.y = .48;
        deck.castShadow = true; deck.receiveShadow = true;
        bridge.add(deck);
        const railMat = new THREE.MeshStandardMaterial({ color:0x58777b, roughness:.7 });
        [-.98,.98].forEach(x => {
          const rail = new THREE.Mesh(new THREE.TorusGeometry(length*.58, .055, 5, 22, Math.PI*.62), railMat);
          rail.rotation.set(0,0,Math.PI/2);
          rail.scale.set(1,1,.66);
          rail.position.set(x,.72,-length*.29);
          bridge.add(rail);
        });
        bridge.userData = { from, to };
        city.add(bridge); bridges.push(bridge);
      }

      function ringMesh(vertices, outerScale, width, material) {
        const outer = vertices.map(v => v.clone().multiplyScalar(outerScale));
        const inner = vertices.map(v => v.clone().multiplyScalar(Math.max(.05,outerScale-width)));
        const shape = polygonShape(THREE, outer);
        const hole = new THREE.Path();
        hole.moveTo(inner[inner.length-1].x, inner[inner.length-1].y);
        for (let i=inner.length-2;i>=0;i--) hole.lineTo(inner[i].x,inner[i].y);
        hole.closePath(); shape.holes.push(hole);
        const mesh = new THREE.Mesh(new THREE.ShapeGeometry(shape), material);
        mesh.rotation.x = Math.PI/2;
        return mesh;
      }

      function polygonShape(T, vertices) {
        const shape = new T.Shape();
        shape.moveTo(vertices[0].x,vertices[0].y);
        for(let i=1;i<vertices.length;i++) shape.lineTo(vertices[i].x,vertices[i].y);
        shape.closePath(); return shape;
      }

      function addPart(bucket, kind, position, scale, color, serviceId=null, rotation=[0,0,0]) {
        if (!DATA.stage2.partKinds.includes(kind)) throw new Error(`不支援的零件種類：${kind}`);
        const jitter = DATA.stage2.scaleJitter;
        const s = new THREE.Vector3(...scale).multiply(new THREE.Vector3(
          1+(rng()*2-1)*jitter, 1+(rng()*2-1)*jitter, 1+(rng()*2-1)*jitter
        ));
        const matrix = new THREE.Matrix4().compose(
          new THREE.Vector3(...position),
          new THREE.Quaternion().setFromEuler(new THREE.Euler(...rotation)),
          s
        );
        partBuckets[bucket].push({ kind, matrix, color });
        partOwners[bucket].push(serviceId);
      }

      function buildServiceModels() {
        const positions = DATA.stage2.serviceGrid;
        DATA.domains.forEach(domain => {
          const island = islandById.get(domain.id);
          domain.services.forEach((service, index) => {
            const archetype = DATA.modelCatalog[service.model];
            if (!archetype) throw new Error(`服務 ${service.id} 使用未知 model：${service.model}`);
            const local = index===0 ? DATA.stage2.mainBuildingPosition : positions[index-1];
            const size = index===0 ? DATA.stage2.mainBuildingScale : .82 + (index%2)*.05;
            const origin=[island.center.x+local[0], .48, island.center.z+local[1]];
            servicePositions.set(service.id,new THREE.Vector3(...origin));
            const gateway=domain.id===DATA.artDirection.showcase.domainId;
            const theme=DATA.artDirection.islandThemes[domain.id];
            buildArchetype(archetype, origin, size, service.id, index===0 && artRng()<DATA.artDirection.friendlyMainFaceChance, gateway, index===0?theme:null);
          });
        });
      }

      function buildArchetype(type, origin, size, serviceId, friendlyFace=false, showcase=false, theme=null) {
        const p=DATA.palette;
        const at=(x,y,z)=>[origin[0]+x*size,origin[1]+y*size,origin[2]+z*size];
        const secure=['vault','lock','token'].includes(type), balanced=type==='load-balancer';
        const normal=balanced?p.teal:secure?p.blush:p.cream, stone=balanced?p.darkTeal:secure?p.stone:p.softStone;
        const part=(kind,x,y,z,sx,sy,sz,color=normal,rot=[0,0,0],bucket='static')=>addPart(bucket,kind,at(x,y,z),[sx*size,sy*size,sz*size],color,serviceId,rot);
        const face=(y,z,spread=.18)=>{if(!friendlyFace)return;[-spread,spread].forEach(x=>part('sphere',x,y,z,.065,.085,.055,p.ink));};
        if(showcase && buildGatewayShowcase(type,part,p))return;
        if(theme && buildThemedMain(type,part,p,theme))return;
        part('cylinder',0,.10,0,1.46,.20,1.46,p.darkStone);
        switch(type) {
          case 'server-array':
            part('rbox',0,.62,0,1.78,1.02,1.26,p.warmCream);
            [-.53,0,.53].forEach((x,i)=>{part('rbox',x,.66,.03,.43,.76,.88,i===1?normal:stone);part('glowsphere',x,.78,.50,.105,.105,.065,p.window,[0,0,0],'glow');});
            face(.58,.51,.19);
            break;
          case 'api-gateway':
            part('rbox',-.67,.69,0,.48,1.16,.74,stone);part('rbox',.67,.69,0,.48,1.16,.74,stone);
            part('torus',0,1.18,.02,.90,.90,.22,normal);part('dome',-.67,1.30,0,.50,.24,.76,p.warmCream);part('dome',.67,1.30,0,.50,.24,.76,p.warmCream);
            part('rbox',0,.23,-.08,1.30,.18,.76,normal);part('glowsphere',0,1.30,.13,.16,.16,.09,p.window,[0,0,0],'glow');
            break;
          case 'database':
            part('cylinder',0,.66,0,1.28,1.12,1.28,normal);[.24,.62,1.00].forEach(y=>part('torus',0,y,0,1.14,1.14,.10,stone,[Math.PI/2,0,0]));
            part('dome',0,1.24,0,1.27,.42,1.27,p.warmCream);part('glowsphere',0,.69,.64,.11,.11,.065,p.window,[0,0,0],'glow');face(.76,.64,.18);
            break;
          case 'vault':
            part('rbox',0,.70,0,1.72,1.25,1.34,normal);part('rbox',0,.70,.67,1.40,1.00,.12,p.warmCream);part('torus',0,.72,.76,.47,.47,.11,p.coral);
            part('cylinder',0,.72,.80,.24,.17,.24,p.darkStone,[Math.PI/2,0,0]);part('sphere',0,.47,.84,.075,.11,.06,p.ink);part('rbox',0,.36,.84,.055,.13,.045,p.ink);face(1.03,.75,.45);
            break;
          case 'adapter':
            part('rbox',0,.51,0,1.72,.72,1.16,normal);part('dome',0,.93,0,1.00,.34,.82,p.warmCream);part('cylinder',0,1.28,0,.13,.44,.13,stone);
            part('torus',0,1.65,.02,.48,.34,.10,p.coral,[.28,0,0]);part('sphere',0,1.65,.04,.15,.12,.10,p.window);face(.55,.59,.20);
            break;
          case 'lock':
            part('rbox',0,.61,0,1.52,1.05,1.14,normal);part('torus',0,1.18,.02,.65,.74,.19,p.coral);part('sphere',0,.64,.60,.105,.15,.075,p.ink);part('rbox',0,.48,.60,.07,.18,.06,p.ink);
            break;
          case 'token':
            part('rbox',0,.27,0,1.38,.34,1.00,p.warmCream);part('cylinder',0,.82,.02,1.08,.32,1.08,normal,[Math.PI/2,0,0]);part('torus',0,.82,.20,.75,.75,.10,p.coral);
            part('sphere',-.22,.82,.37,.17,.17,.07,p.warmCream);part('rbox',.16,.82,.38,.55,.13,.07,p.warmCream);part('rbox',.36,.69,.39,.12,.22,.07,p.warmCream);
            break;
          case 'clock':
            part('rbox',0,.31,0,.82,.45,.72,stone);part('cylinder',0,.91,.08,1.12,.28,1.12,normal,[Math.PI/2,0,0]);part('cylinder',0,.91,.24,.91,.12,.91,p.warmCream,[Math.PI/2,0,0]);
            part('rbox',0,1.02,.32,.065,.34,.045,p.ink,[0,0,-.38]);part('rbox',.12,.84,.33,.32,.06,.045,p.ink,[0,0,.20]);[-.43,.43].forEach(x=>part('sphere',x,1.48,.02,.30,.22,.30,p.coral));
            break;
          case 'globe':
            part('rbox',0,.22,0,1.10,.28,.78,stone);part('torus',0,.76,0,.83,.98,.12,p.darkStone,[0,0,-.20]);part('sphere',0,.86,0,.78,.78,.78,normal);
            part('torus',0,.86,0,.80,.80,.045,p.teal);part('torus',0,.86,0,.80,.80,.045,p.teal,[0,Math.PI/2,0]);
            break;
          case 'load-balancer':
            part('rbox',-.58,.57,0,.74,.92,1.02,normal);part('rbox',.58,.57,0,.74,.92,1.02,normal);part('sphere',0,1.05,.02,.34,.34,.34,p.warmCream);
            part('torus',0,1.05,.04,.47,.47,.10,p.coral);[-.58,.58].forEach(x=>part('glowsphere',x,.61,.53,.15,.15,.07,p.window,[0,0,0],'glow'));
            break;
          case 'message-queue':
            part('rbox',0,.58,0,1.82,.88,1.12,normal);part('dome',0,1.08,0,1.08,.32,.78,p.warmCream);
            [-.55,0,.55].forEach((x,i)=>{part('rbox',x,.64,.59,.40,.31,.10,i===1?p.coral:stone);part('prism',x,.73,.66,.23,.16,.06,p.warmCream,[0,0,Math.PI/2]);});face(.40,.60,.23);
            break;
          case 'monolith':
            part('rbox',0,.79,0,1.78,1.42,1.30,normal);part('dome',0,1.53,0,1.08,.32,.91,stone);
            [-.46,0,.46].forEach(x=>part('glowbox',x,.83,.66,.24,.49,.045,p.window,[0,0,0],'glow'));part('rbox',0,.29,.67,.42,.34,.08,p.teal);face(1.27,.66,.25);
            break;
          default: throw new Error(`缺少模型原型：${type}`);
        }
      }

      function buildGatewayShowcase(type,part,p) {
        const sand=DATA.artDirection.showcase.plazaInset;
        switch(type){
          case 'api-gateway':
            part('cylinder',0,.10,0,2.85,.19,2.25,sand);
            part('rbox',0,.82,-.42,2.32,1.48,1.46,p.warmCream);
            [-1.05,1.05].forEach(x=>{
              part('cylinder',x,.74,-.19,.58,1.30,.58,p.cream);
              part('dome',x,1.43,-.19,.62,.35,.62,p.softStone);
              part('glowsphere',x,.84,.40,.13,.22,.08,p.lamp,[0,0,0],'glow');
            });
            part('rbox',0,.75,.41,.90,1.10,.13,p.darkTeal);
            part('rbox',0,1.63,-.40,2.08,.34,1.48,p.cream);
            part('dome',0,1.77,-.40,1.83,.90,1.46,p.teal);
            part('torus',0,1.18,.62,1.55,1.55,.23,p.cream);
            [-.82,.82].forEach(x=>part('rbox',x,.64,.77,.46,1.17,.48,p.cream));
            part('rbox',0,.19,1.03,1.48,.24,.57,p.cream);
            part('rbox',0,1.05,1.02,1.01,.14,.37,p.coral);
            [-.15,.15].forEach(x=>part('sphere',x,1.47,.72,.095,.105,.06,p.ink));
            part('sphere',0,2.25,-.40,.24,.24,.24,p.warmCream);
            break;
          case 'server-array':
            part('rbox',0,.13,0,2.05,.25,1.63,sand);
            part('rbox',0,.79,-.16,2.00,1.18,1.22,p.warmCream);
            [-.55,0,.55].forEach((x,i)=>{
              part('rbox',x,.72,.48,.49,.91,.58,i===1?p.darkTeal:p.teal);
              part('glowsphere',x,.95,.79,.19,.14,.07,p.lamp,[0,0,0],'glow');
              part('rbox',x,.59,.79,.28,.09,.045,p.ink);
            });
            part('rbox',0,1.44,-.15,2.11,.23,1.27,p.cream);
            break;
          case 'vault':
            part('cylinder',0,.12,0,1.84,.23,1.70,sand);
            part('rbox',0,.72,-.10,1.72,1.18,1.37,p.cream);
            part('dome',0,1.35,-.10,1.64,.49,1.29,p.blush);
            part('rbox',0,.64,.64,.98,.90,.18,p.coral);
            part('torus',0,.79,.76,.70,.82,.12,p.darkStone);
            part('cylinder',0,.71,.84,.28,.18,.28,p.lamp,[Math.PI/2,0,0]);
            part('sphere',0,1.55,-.10,.17,.17,.17,p.warmCream);
            break;
          case 'load-balancer':
            part('rbox',0,.13,0,2.00,.24,1.52,sand);
            part('rbox',0,.58,-.04,1.84,.69,1.13,p.warmCream);
            [-.70,.70].forEach(x=>{
              part('cylinder',x,.81,0,.55,1.18,.55,p.teal);
              part('dome',x,1.43,0,.59,.32,.59,p.darkTeal);
              part('glowbox',x,.84,.30,.15,.46,.045,p.lamp,[0,0,0],'glow');
            });
            part('rbox',0,.91,.54,.72,.52,.20,p.cream);
            [-.22,.22].forEach(x=>part('sphere',x,.96,.68,.19,.19,.12,p.coral));
            break;
          default:return false;
        }
        return true;
      }

      // Only the primary service receives its island's architectural silhouette.
      // The service model still chooses the archetype; art data chooses its local finish.
      function buildThemedMain(type,part,p,art) {
        if(type!==art.mainArchetype) throw new Error(`Island art expects ${art.mainArchetype}, received ${type}`);
        const accent=art.accent, sand=art.plazaInset;
        switch(art.mainForm) {
          case 'shield-lock':
            part('cylinder',0,.12,0,2.70,.22,2.25,sand);
            part('rbox',0,.76,-.18,2.20,1.28,1.50,p.warmCream);
            [-.92,.92].forEach(x=>{
              part('cylinder',x,.82,-.15,.49,1.35,.50,accent);
              part('dome',x,1.50,-.15,.55,.29,.56,p.cream);
            });
            part('torus',0,1.63,-.25,1.25,1.37,.24,accent);
            part('rbox',0,.76,.61,1.35,1.02,.24,p.cream);
            part('ico',0,.78,.78,.76,.85,.17,accent);
            part('torus',0,.79,.90,.51,.58,.12,p.warmCream);
            part('sphere',0,.82,1.00,.12,.15,.06,p.ink);
            part('rbox',0,.60,1.02,.07,.20,.06,p.ink);
            part('dome',0,1.48,-.15,1.18,.33,1.07,p.softStone);
            [-.58,.58].forEach(x=>part('glowsphere',x,.49,.79,.10,.17,.06,p.lamp,[0,0,0],'glow'));
            break;
          case 'ledger-drums':
            part('cylinder',0,.12,0,2.76,.23,2.55,sand);
            [0,.51,1.02].forEach((rise,i)=>{
              const radius=2.15-i*.13;
              part('cylinder',0,.45+rise,-.13,radius,.61,radius,i===1?p.cream:p.warmCream);
              part('torus',0,.73+rise,-.13,radius*.94,radius*.94,.12,i===1?accent:p.softStone,[Math.PI/2,0,0]);
            });
            part('dome',0,1.83,-.13,1.95,.48,1.95,accent);
            part('cylinder',0,2.03,-.13,.43,.15,.43,p.warmCream);
            part('rbox',0,.75,1.01,1.10,.80,.18,p.cream);
            [-.33,0,.33].forEach((x,i)=>{
              part('glowbox',x,.85,1.12,.16,.37,.05,p.lamp,[0,0,0],'glow');
              part('sphere',x,.48,1.13,.07,.07,.055,i===1?p.coral:accent);
            });
            break;
          case 'cipher-vault':
            part('cylinder',0,.12,0,2.78,.23,2.38,sand);
            part('rbox',0,.82,-.12,2.30,1.52,1.66,p.warmCream);
            part('dome',0,1.62,-.12,2.28,.50,1.62,p.softStone);
            part('rbox',0,.83,.76,1.49,1.24,.20,accent);
            part('torus',0,.86,.88,1.02,1.04,.15,p.cream);
            part('cylinder',0,.86,1.04,.47,.19,.47,p.clay,[Math.PI/2,0,0]);
            [-.26,.26].forEach(x=>part('rbox',x,.86,1.17,.43,.075,.07,p.warmCream));
            [-.24,.24].forEach(y=>part('rbox',0,.86+y,1.17,.075,.43,.07,p.warmCream));
            [-1.08,1.08].forEach(x=>{
              part('cylinder',x,.68,-.22,.42,.96,.42,accent);
              part('dome',x,1.18,-.22,.47,.27,.47,p.cream);
              part('glowbox',x,.82,.03,.16,.35,.05,p.lamp,[0,0,0],'glow');
            });
            part('sphere',0,1.40,.79,.14,.14,.11,p.coral);
            break;
          case 'customer-hall':
            part('cylinder',0,.12,0,2.72,.22,2.38,sand);
            part('rbox',0,.72,-.22,2.04,1.17,1.47,p.warmCream);
            [-.89,.89].forEach(x=>{
              part('rbox',x,.56,-.12,.50,.84,1.24,p.cream);
              part('dome',x,1.03,-.12,.56,.28,1.27,accent);
              part('glowbox',x,.64,.53,.21,.27,.05,p.lamp,[0,0,0],'glow');
            });
            part('dome',0,1.33,-.25,1.60,.58,1.30,p.softStone);
            part('rbox',0,.54,.58,.53,.70,.16,accent);
            part('sphere',-.18,1.65,-.18,.18,.18,.18,p.cream);
            part('sphere',.18,1.65,-.18,.18,.18,.18,p.cream);
            break;
          case 'market-shelves':
            part('cylinder',0,.12,0,2.72,.22,2.35,sand);
            part('rbox',0,.72,-.17,2.24,1.15,1.45,p.warmCream);
            [-.78,.78].forEach(x=>{
              part('rbox',x,.57,.60,.55,.66,.18,accent);
              part('glowbox',x,.65,.71,.30,.30,.05,p.lamp,[0,0,0],'glow');
            });
            part('rbox',0,.50,.63,.42,.72,.20,p.darkTeal);
            part('rbox',0,1.32,-.17,2.39,.27,1.59,p.cream);
            part('dome',0,1.48,-.17,1.81,.43,1.31,accent);
            [-.55,0,.55].forEach((x,i)=>part('rbox',x,1.67,-.15,.30,.22,.30,i===1?p.blush:p.warmCream));
            break;
          case 'storage-bins':
            part('cylinder',0,.12,0,2.75,.22,2.46,sand);
            part('rbox',0,.49,-.15,2.18,.70,1.62,p.warmCream);
            [-.66,0,.66].forEach((x,i)=>{
              part('rbox',x,.94,-.26,.57,1.18,.94,i===1?accent:p.cream);
              part('dome',x,1.56,-.26,.59,.30,.96,p.softStone);
              part('glowbox',x,.87,.24,.25,.25,.05,p.lamp,[0,0,0],'glow');
            });
            part('rbox',0,1.58,-.35,2.35,.21,1.24,p.softStone);
            part('rbox',0,.43,.74,.62,.52,.13,accent);
            break;
          case 'dispatch-post':
            part('cylinder',0,.12,0,2.75,.22,2.38,sand);
            part('rbox',0,.65,-.20,2.24,1.04,1.53,p.warmCream);
            part('dome',0,1.22,-.20,2.12,.40,1.48,accent);
            part('rbox',0,.45,.61,.59,.59,.16,p.darkTeal);
            [-.77,.77].forEach(x=>{
              part('rbox',x,.71,.57,.39,.38,.14,p.cream);
              part('glowbox',x,.70,.66,.20,.18,.05,p.lamp,[0,0,0],'glow');
            });
            part('rbox',0,1.53,-.30,.57,.36,.47,p.cream);
            part('sphere',0,1.73,-.27,.19,.19,.19,p.coral);
            part('rbox',.89,.19,.91,.66,.22,.55,p.softStone);
            break;
          case 'message-bell':
            part('cylinder',0,.12,0,2.70,.22,2.34,sand);
            part('rbox',0,.69,-.18,2.10,1.13,1.42,p.warmCream);
            part('dome',0,1.29,-.18,2.04,.56,1.39,accent);
            part('rbox',0,.67,.62,1.21,.64,.19,p.cream);
            part('prism',0,.75,.75,.71,.22,.11,accent,[Math.PI/2,0,0]);
            part('rbox',0,.47,.75,.73,.075,.10,p.clay);
            [-.84,.84].forEach(x=>{
              part('sphere',x,1.16,.12,.21,.21,.21,p.cream);
              part('glowsphere',x,.70,.57,.12,.12,.06,p.lamp,[0,0,0],'glow');
            });
            part('sphere',0,1.75,-.18,.23,.23,.23,p.warmCream);
            break;
          case 'data-observatory':
            part('cylinder',0,.12,0,2.68,.22,2.38,sand);
            part('cylinder',0,.76,-.18,2.03,1.18,1.99,p.warmCream);
            part('torus',0,.42,-.18,1.97,1.97,.12,accent,[Math.PI/2,0,0]);
            part('torus',0,1.22,-.18,1.97,1.97,.11,p.softStone,[Math.PI/2,0,0]);
            part('dome',0,1.43,-.18,1.98,.62,1.95,accent);
            part('rbox',0,.60,.92,1.21,.57,.17,p.cream);
            [-.33,0,.33].forEach((x,i)=>part('glowbox',x,.64,.99,.16,.20+i*.10,.05,p.lamp,[0,0,0],'glow'));
            part('sphere',0,1.97,-.18,.16,.16,.16,p.warmCream);
            break;
          case 'control-terrace':
            part('cylinder',0,.12,0,2.75,.22,2.40,sand);
            part('rbox',0,.63,-.18,2.18,.98,1.55,p.warmCream);
            [-.91,.91].forEach(x=>{
              part('rbox',x,1.09,-.25,.51,.89,.77,accent);
              part('dome',x,1.55,-.25,.54,.27,.78,p.cream);
              part('glowbox',x,.91,.17,.20,.34,.05,p.lamp,[0,0,0],'glow');
            });
            part('rbox',0,1.23,-.26,1.17,.27,1.13,p.softStone);
            part('rbox',0,.46,.67,.59,.61,.15,p.darkTeal);
            part('cylinder',0,1.65,-.23,.19,.40,.19,p.clay);
            part('sphere',0,1.91,-.23,.24,.24,.24,p.coral);
            break;
          case 'watchtower-eye':
            part('cylinder',0,.12,0,2.72,.22,2.40,sand);
            part('rbox',0,.47,-.16,2.10,.70,1.52,p.warmCream);
            [-.75,.75].forEach(x=>{
              part('cylinder',x,.82,-.17,.44,1.10,.45,p.cream);
              part('dome',x,1.40,-.17,.48,.27,.47,accent);
            });
            part('torus',0,1.39,-.19,1.54,1.54,.16,p.softStone);
            part('sphere',0,1.39,-.19,1.20,1.20,1.20,accent);
            part('sphere',0,1.42,.45,.52,.52,.30,p.cream);
            part('sphere',0,1.42,.65,.25,.25,.15,p.darkTeal);
            part('rbox',0,.34,.64,.56,.43,.17,p.clay);
            break;
          default: throw new Error(`Unknown island art form: ${art.mainForm}`);
        }
        return true;
      }

      function buildIslandFurniture() {
        const p=DATA.palette;
        DATA.domains.forEach((domain,islandIndex)=>{
          const island=islandById.get(domain.id), verts=island.vertices, c=island.center;
          verts.forEach(v=>{
            const x=c.x+v.x, z=c.z+v.y;
            addPart('static','cylinder',[x,.88,z],[.12,.72,.12],p.darkStone);
            addPart('static','dome',[x,1.58,z],[.38,.22,.38],p.warmCream);
            addPart('glow','glowsphere',[x,1.48,z],[.19,.14,.19],p.lamp);
            addPart('glow','glowsphere',[x,.53,z],[1.05,.025,1.05],p.lamp);
          });
          if(domain.id===DATA.artDirection.showcase.domainId){buildGatewayPlaza(island);return;}
          const theme=DATA.artDirection.islandThemes[domain.id];
          if(theme){buildThemedPlaza(island,theme);return;}
          for(let edge=0;edge<6;edge++) {
            const a=verts[edge], b=verts[(edge+1)%6];
            const planterT=edge%2?.28:.72;
            const mx=c.x+THREE.MathUtils.lerp(a.x,b.x,planterT)*.90, mz=c.z+THREE.MathUtils.lerp(a.y,b.y,planterT)*.90;
            addPart('static','cylinder',[mx,.63,mz],[.54,.29,.54],p.clay);
            addPart('static','dome',[mx,.91,mz],[.54,.34,.54],edge%2?p.leaf:p.darkLeaf);
            [-.24,.24].forEach((dx,petal)=>{addPart('static','sphere',[mx+dx,.99,mz],[.14,.12,.14],petal?p.flower:p.warmCream);});
            for(let j=1;j<=2;j++) {
              const t=j/3, x=c.x+THREE.MathUtils.lerp(a.x,b.x,t)*.94, z=c.z+THREE.MathUtils.lerp(a.y,b.y,t)*.94;
              addPart('glow','glowsphere',[x,.63,z],[.075,.075,.075],p.lamp);
            }
          }
          const treeCount=DATA.stage2.treesPerIsland[islandIndex];
          for(let i=0;i<treeCount;i++) {
            const angle=(i/treeCount)*Math.PI*2 + .24 + islandIndex*.11;
            const radius=7.15+(i%2)*.3, x=c.x+Math.cos(angle)*radius, z=c.z+Math.sin(angle)*radius;
            addPart('static','cylinder',[x,.99,z],[.23,.86,.23],p.trunk);
            const form=islandIndex%3;
            const wobble=(artRng()-.5)*.12;
            if(form===0) { addPart('static','sphere',[x-.27,2.08,z],[.72,.63,.72],p.darkLeaf);addPart('static','sphere',[x+.28,2.12,z+.05],[.70,.65,.70],p.leaf);addPart('static','dome',[x,2.55+wobble,z],[.78,.50,.78],p.leaf); }
            else if(form===1) { addPart('static','ico',[x-.30,2.11,z],[.68,.70,.68],p.leaf);addPart('static','ico',[x+.30,2.17,z+.08],[.66,.72,.66],p.darkLeaf);addPart('static','sphere',[x,2.54+wobble,z-.04],[.62,.57,.62],p.leaf); }
            else { addPart('static','dome',[x,2.02,z],[.92,.62,.92],p.darkLeaf);addPart('static','sphere',[x-.22,2.40+wobble,z],[.60,.54,.60],p.leaf);addPart('static','sphere',[x+.25,2.43,z+.08],[.57,.52,.57],p.leaf); }
          }
          [-1,1].forEach(side=>{
            const x=c.x+side*3.4,z=c.z+.25;
            addPart('near','rbox',[x,.72,z],[.62,.56,.50],p.softStone);
            addPart('near','glowbox',[x,.80,z+.46],[.22,.18,.025],p.window);
          });
        });
      }

      // Fills free rim and path-band space with toy houses, bushes and parasols, keeping clear of roads and existing furniture.
      function buildIslandDensity(){
        const cfg=DATA.artDirection.density,p=DATA.palette,densityRng=mulberry32(cfg.seed);
        const segDist=(px,pz,ax,az,bx,bz)=>{const dx=bx-ax,dz=bz-az,t=THREE.MathUtils.clamp(((px-ax)*dx+(pz-az)*dz)/(dx*dx+dz*dz||1),0,1);return Math.hypot(px-ax-dx*t,pz-az-dz*t);};
        const polyDist=(x,z,poly)=>{let d=Infinity;poly.forEach((a,i)=>{const b=poly[(i+1)%poly.length];d=Math.min(d,segDist(x,z,a.x,a.y,b.x,b.y));});return d;};
        const side=(x,z,poly,sign)=>poly.every((a,i)=>{const b=poly[(i+1)%poly.length];return sign*((b.x-a.x)*(z-a.y)-(b.y-a.y)*(x-a.x))>=0;});
        const inside=(x,z,poly)=>side(x,z,poly,1)||side(x,z,poly,-1);
        DATA.domains.forEach(domain=>{
          const island=islandById.get(domain.id),{center:c,vertices:verts}=island;
          const art=domain.id===DATA.artDirection.showcase.domainId?DATA.artDirection.showcase:DATA.artDirection.islandThemes[domain.id];
          const curb=verts.map(v=>v.clone().multiplyScalar(cfg.curbScale)),plaza=verts.map(v=>v.clone().multiplyScalar(cfg.plazaScale));
          const roads=[];
          for(let i=0;i<6;i++){const ring=roadGraph.get(`${domain.id}:ring:${i}`);ring.links.forEach(id=>{const other=roadGraph.get(id);if(id.startsWith(`${domain.id}:`))roads.push([ring.position.x-c.x,ring.position.z-c.z,other.position.x-c.x,other.position.z-c.z]);});}
          const obstacles=[];
          domain.services.forEach((service,index)=>{const pos=servicePositions.get(service.id);obstacles.push([pos.x-c.x,pos.z-c.z,index===0?2.1:1.25]);});
          (art.trees||art.treeClusters).forEach(([x,z])=>obstacles.push([x,z,.95]));
          (art.beds||art.flowerBeds).forEach(([x,z])=>obstacles.push([x,z,.62]));
          if(art.nearCabinets)[-1,1].forEach(dir=>obstacles.push([dir*3.4,.25,.5]));
          verts.forEach((a,i)=>{const b=verts[(i+1)%6];[1,2].forEach(j=>obstacles.push([THREE.MathUtils.lerp(a.x,b.x,j/3)*.94,THREE.MathUtils.lerp(a.y,b.y,j/3)*.94,.2]));});
          const candidates=[];
          for(let x=-ISLAND_RADIUS;x<=ISLAND_RADIUS;x+=cfg.gridStep)for(let z=-ISLAND_RADIUS;z<=ISLAND_RADIUS;z+=cfg.gridStep)candidates.push([x+(densityRng()-.5)*cfg.gridStep*.6,z+(densityRng()-.5)*cfg.gridStep*.6,densityRng()]);
          candidates.sort((a,b)=>a[2]-b[2]);
          const lawns=[];
          candidates.forEach(([x,z])=>{
            const r=cfg.lawn.radius;
            if(lawns.length>=cfg.lawn.max||!inside(x,z,curb)||polyDist(x,z,curb)<r*.9||inside(x,z,plaza)||polyDist(x,z,plaza)<.25
              ||roads.some(([ax,az,bx,bz])=>segDist(x,z,ax,az,bx,bz)<r*.8+.35)||lawns.some(([ox,oz])=>Math.hypot(x-ox,z-oz)<r*1.8))return;
            lawns.push([x,z]);
            addPart('static','cylinder',[c.x+x,.445,c.z+z],[r*2.2,.03,r*1.7],cfg.lawn.colors[lawns.length%cfg.lawn.colors.length],null,[0,densityRng()*Math.PI,0]);
          });
          const placed=[],counts={house:0,bush:0,parasol:0};
          const fits=(x,z,r)=>inside(x,z,verts)&&polyDist(x,z,verts)>=r+cfg.edgeMargin&&!inside(x,z,plaza)&&polyDist(x,z,curb)>=r+.1
            &&roads.every(([ax,az,bx,bz])=>segDist(x,z,ax,az,bx,bz)>=r+cfg.roadClearance)&&obstacles.every(([ox,oz,or])=>Math.hypot(x-ox,z-oz)>=r+or)
            &&placed.every(([ox,oz,or])=>Math.hypot(x-ox,z-oz)>=r+or+cfg.spacing);
          candidates.forEach(([x,z])=>{
            const rim=!inside(x,z,curb),kind=rim?'house':counts.bush<cfg.bush.max?'bush':'parasol',spec=cfg[kind];
            if(counts[kind]>=spec.max||!fits(x,z,spec.radius))return;
            placed.push([x,z,spec.radius]);counts[kind]++;
            const wx=c.x+x,wz=c.z+z,pick=list=>list[Math.floor(densityRng()*list.length)];
            if(kind==='house'){
              const yaw=Math.atan2(-x,-z),w=1+densityRng()*.18,h=.66+densityRng()*.24,d=.7+densityRng()*.08,fx=Math.sin(yaw),fz=Math.cos(yaw),wall=pick(cfg.house.walls);
              let top=.35+h;
              addPart('static','rbox',[wx,.35+h/2,wz],[w,h,d],wall,null,[0,yaw,0]);
              if(densityRng()<cfg.house.twoStoryChance){addPart('static','rbox',[wx,top+.22,wz],[w*.72,.44,d*.86],wall,null,[0,yaw,0]);top+=.44;}
              addPart('static','prism',[wx,top+.14,wz],[w/.866*1.1,d*1.14,.56],pick(cfg.house.roofs),null,[-Math.PI/2,yaw,0,'YXZ']);
              addPart('static','rbox',[wx+fx*(d/2+.01),.5,wz+fz*(d/2+.01)],[.18,.3,.04],p.trunk,null,[0,yaw,0]);
              [-1,1].forEach(dir=>addPart('glow','glowbox',[wx+fx*(d/2+.02)+fz*.27*dir,.35+h*.6,wz+fz*(d/2+.02)-fx*.27*dir],[.2,.2,.03],p.lamp,null,[0,yaw,0]));
            }else if(kind==='bush'){
              addPart('static','sphere',[wx,.64,wz],[.86,.7,.86],art.foliage||p.leaf);
              addPart('static','sphere',[wx+.36,.56,wz+.16],[.58,.48,.58],p.darkLeaf);
              if(densityRng()<.5)addPart('static','sphere',[wx-.12,.72,wz-.06],[.1,.09,.1],p.flower);
            }else{
              addPart('static','cylinder',[wx,.73,wz],[.05,.76,.05],p.darkStone);
              addPart('static','cone',[wx,1.17,wz],[.92,.3,.92],pick(cfg.parasol.canopies));
              addPart('static','cylinder',[wx,.55,wz],[.42,.04,.42],p.warmCream);
            }
          });
        });
      }

      // Decorative toy cars drive the road graph so the overview feels busy; they carry no traffic data and are not pickable.
      function createCars(){
        const cfg=DATA.ambient.cars,carRng=mulberry32(cfg.seed),count=innerWidth<=DATA.stage5.mobileBreakpoint?cfg.mobileCount:cfg.desktopCount;
        const nodes=[...roadGraph.values()].filter(node=>node.links.size),islandOf=id=>id.split(':')[0];
        const shaped=(sx,sy,sz,y,z=0)=>{const geometry=makeRoundedBoxGeometry();geometry.scale(sx,sy,sz);geometry.translate(0,y,z);return geometry;};
        const meshes=[
          new THREE.InstancedMesh(shaped(.5,.24,.92,.24),new THREE.MeshStandardMaterial({color:0xffffff,roughness:.7}),count),
          new THREE.InstancedMesh(shaped(.42,.2,.5,.44,-.06),new THREE.MeshStandardMaterial({color:cfg.cabin,roughness:.5}),count),
          new THREE.InstancedMesh(shaped(.54,.14,.74,.09),new THREE.MeshStandardMaterial({color:cfg.wheels,roughness:.95}),count)
        ];
        const cars=Array.from({length:count},(_,i)=>{
          const from=nodes[Math.floor(carRng()*nodes.length)],links=[...from.links];
          meshes[0].setColorAt(i,new THREE.Color(cfg.colors[i%cfg.colors.length]));
          return{from,to:roadGraph.get(links[Math.floor(carRng()*links.length)]),t:carRng(),speed:THREE.MathUtils.lerp(...cfg.speed,carRng()),
            side:THREE.MathUtils.lerp(...cfg.lateral,carRng()),phase:carRng()*Math.PI*2,scale:THREE.MathUtils.lerp(...cfg.scale,carRng()),x:null,z:null,yaw:0};
        });
        const matrix=new THREE.Matrix4(),euler=new THREE.Euler(),quat=new THREE.Quaternion(),pos=new THREE.Vector3(),scl=new THREE.Vector3();
        let viewScale=1;
        // Smoothing keeps corners from snapping when the lane offset and heading change at a node.
        const place=(car,i,delta=0)=>{
          const a=car.from.position,b=car.to.position,dx=b.x-a.x,dz=b.z-a.z,len=Math.hypot(dx,dz)||1,onBridge=islandOf(car.from.id)!==islandOf(car.to.id);
          const x=a.x+dx*car.t-dz/len*car.side,z=a.z+dz*car.t+dx/len*car.side,yaw=Math.atan2(dx,dz),k=car.x===null?1:Math.min(1,delta*cfg.turnRate);
          car.x=car.x===null?x:THREE.MathUtils.lerp(car.x,x,k);car.z=car.z===null?z:THREE.MathUtils.lerp(car.z,z,k);
          car.yaw+=Math.atan2(Math.sin(yaw-car.yaw),Math.cos(yaw-car.yaw))*(delta?k:1);
          pos.set(car.x,(onBridge?cfg.bridgeY:cfg.groundY)+Math.sin(car.phase)*cfg.bob,car.z);
          quat.setFromEuler(euler.set(0,car.yaw,0));scl.setScalar(car.scale*viewScale);
          matrix.compose(pos,quat,scl);meshes.forEach(mesh=>mesh.setMatrixAt(i,matrix));
        };
        cars.forEach(car=>{car.yaw=Math.atan2(car.to.position.x-car.from.position.x,car.to.position.z-car.from.position.z);});
        cars.forEach((car,i)=>place(car,i));
        meshes.forEach(mesh=>{mesh.frustumCulled=false;mesh.castShadow=false;mesh.receiveShadow=false;scene.add(mesh);});
        const flush=()=>meshes.forEach(mesh=>mesh.instanceMatrix.needsUpdate=true);
        carField={count,
          // Far cameras enlarge the cars so the traffic still reads in the overview.
          setViewDistance(distance){const {near,far,max}=cfg.distanceScale,next=THREE.MathUtils.lerp(1,max,THREE.MathUtils.smoothstep(distance,near,far));if(Math.abs(next-viewScale)<.02)return;viewScale=next;cars.forEach((car,i)=>place(car,i));flush();},
          update(delta){
            cars.forEach((car,i)=>{
              car.t+=car.speed*delta/(car.from.position.distanceTo(car.to.position)||1);car.phase+=delta*cfg.idleRate;
              if(car.t>=1){const options=[...car.to.links].filter(id=>id!==car.from.id),next=options.length?options[Math.floor(carRng()*options.length)]:car.from.id;car.from=car.to;car.to=roadGraph.get(next);car.t=0;}
              place(car,i,delta);
            });
            flush();
          }};
      }

      function buildGatewayPlaza(island){
        const {center:c,vertices:verts}=island,p=DATA.palette,art=DATA.artDirection.showcase;
        const placed=(kind,x,y,z,sx,sy,sz,color,rotation=[0,0,0],bucket='static')=>addPart(bucket,kind,[c.x+x,y,c.z+z],[sx,sy,sz],color,null,rotation);
        placed('cylinder',0,.385,0,7.2,.045,7.2,art.plazaInset);
        placed('torus',0,.42,0,6.25,6.25,.10,art.curb,[Math.PI/2,0,0]);
        for(let edge=0;edge<6;edge++){
          const a=verts[edge],b=verts[(edge+1)%6];
          for(let j=1;j<=2;j++){
            const t=j/3,x=THREE.MathUtils.lerp(a.x,b.x,t)*.94,z=THREE.MathUtils.lerp(a.y,b.y,t)*.94;
            placed('glowsphere',x,.63,z,.075,.075,.075,p.lamp,[0,0,0],'glow');
          }
        }
        art.treeClusters.forEach(([x,z],index)=>{
          placed('cylinder',x,.43,z,1.65,.15,1.40,index%2?p.clay:art.path);
          placed('cylinder',x,.93,z,.24,.91,.24,p.trunk);
          const wobble=(artRng()-.5)*.14;
          placed('sphere',x-.29,1.94,z,.80,.74,.80,index%2?p.leaf:p.darkLeaf);
          placed('sphere',x+.31,2.02,z+.08,.76,.77,.76,p.leaf);
          placed('dome',x,2.33+wobble,z-.10,.95,.52,.90,index%2?p.darkLeaf:p.leaf);
          [-.66,.64].forEach((offset,j)=>placed('sphere',x+offset,.67,z+.27*(j?1:-1),.38,.35,.38,j?p.leaf:p.darkLeaf));
        });
        art.flowerBeds.forEach(([x,z],index)=>{
          placed('cylinder',x,.44,z,1.05,.18,.83,art.path);
          placed('dome',x,.62,z,.81,.36,.70,index%2?p.darkLeaf:p.leaf);
          [-.22,.22].forEach((offset,j)=>placed('sphere',x+offset,.77,z,.16,.14,.16,j?p.flower:p.warmCream));
        });
      }

      function buildThemedPlaza(island,art){
        const {center:c,vertices:verts}=island,p=DATA.palette;
        const placed=(kind,x,y,z,sx,sy,sz,color,rotation=[0,0,0],bucket='static')=>
          addPart(bucket,kind,[c.x+x,y,c.z+z],[sx,sy,sz],color,null,rotation);
        placed('cylinder',0,.385,0,7.20,.045,7.20,art.plazaInset);
        if(art.plazaForm==='shield'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('cylinder',0,.414,-.72,2.85,.025,2.85,art.plaza);
          placed('torus',0,.438,-.72,2.78,2.78,.065,art.accent,[Math.PI/2,0,0]);
        }else if(art.plazaForm==='ledger'){
          placed('torus',0,.426,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('torus',0,.438,-.50,4.15,4.15,.07,art.accent,[Math.PI/2,0,0]);
          placed('cylinder',0,.418,-.50,2.60,.025,2.60,art.plaza);
        }else if(art.plazaForm==='cipher'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('rbox',-.58,.413,-.48,2.45,.045,2.55,art.plaza);
          placed('rbox',.82,.415,-.48,1.50,.05,2.15,art.plaza);
          placed('rbox',.08,.442,-.48,.14,.035,2.25,art.accent);
        }else if(art.plazaForm==='courtyard'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('cylinder',0,.414,-.50,2.95,.025,2.95,art.plaza);
          [-1.45,1.45].forEach(x=>placed('cylinder',x,.438,-.50,.74,.035,.74,art.accent));
        }else if(art.plazaForm==='market'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('rbox',0,.414,-.45,3.08,.025,2.60,art.plaza);
          [-1.03,0,1.03].forEach(x=>placed('rbox',x,.438,-.45,.22,.03,2.22,art.accent));
        }else if(art.plazaForm==='stock'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('cylinder',0,.413,-.48,3.13,.025,2.89,art.plaza);
          [-.90,0,.90].forEach(x=>placed('rbox',x,.438,-.51,.13,.03,2.20,art.accent));
        }else if(art.plazaForm==='route'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('cylinder',0,.413,-.46,3.04,.025,3.04,art.plaza);
          placed('rbox',-.55,.438,-.55,.15,.03,2.42,art.accent,[0,.28,0]);
          placed('rbox',.54,.438,-.47,.15,.03,2.36,art.accent,[0,-.28,0]);
        }else if(art.plazaForm==='message'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('rbox',0,.414,-.46,3.10,.025,2.72,art.plaza);
          placed('rbox',0,.438,-.45,2.16,.03,.11,art.accent,[0,-.36,0]);
          placed('rbox',0,.438,-.45,2.16,.03,.11,art.accent,[0,.36,0]);
        }else if(art.plazaForm==='orbit'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('cylinder',0,.413,-.48,3.04,.025,3.04,art.plaza);
          placed('torus',0,.439,-.48,2.75,2.20,.07,art.accent,[Math.PI/2,0,.35]);
          placed('cylinder',1.23,.449,-.11,.20,.035,.20,p.coral);
        }else if(art.plazaForm==='circuit'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('rbox',0,.414,-.48,3.02,.025,2.82,art.plaza);
          placed('rbox',0,.438,-.48,2.56,.03,.11,art.accent);
          placed('rbox',0,.438,-.48,.11,.03,2.33,art.accent);
        }else if(art.plazaForm==='radar'){
          placed('torus',0,.425,0,6.20,6.20,.10,art.curb,[Math.PI/2,0,0]);
          placed('cylinder',0,.414,-.48,3.06,.025,3.06,art.plaza);
          placed('torus',0,.439,-.48,2.50,2.50,.07,art.accent,[Math.PI/2,0,0]);
          placed('rbox',0,.440,-.48,.10,.03,2.56,art.accent);
        }else{
          throw new Error(`Unknown island plaza form: ${art.plazaForm}`);
        }
        for(let edge=0;edge<6;edge++){
          const a=verts[edge],b=verts[(edge+1)%6];
          for(let j=1;j<=2;j++){
            const t=j/3,x=THREE.MathUtils.lerp(a.x,b.x,t)*.94,z=THREE.MathUtils.lerp(a.y,b.y,t)*.94;
            placed('glowsphere',x,.63,z,.075,.075,.075,p.lamp,[0,0,0],'glow');
          }
        }
        art.trees.forEach(([x,z],i)=>{
          placed('cylinder',x,.43,z,1.64,.15,1.42,i%2?art.path:art.curb);
          placed('cylinder',x,.96,z,.24,.95,.24,p.trunk);
          const offset=(artRng()-.5)*.12;
          if(art.plazaForm==='ledger'||art.treeForm==='layered'){
            placed('sphere',x-.30,1.94,z,.76,.73,.77,art.foliage);
            placed('sphere',x+.32,2.02,z+.06,.74,.75,.74,p.leaf);
            placed('sphere',x,2.40+offset,z-.08,.62,.58,.63,p.darkLeaf);
          }else if(art.plazaForm==='cipher'||art.treeForm==='rounded'){
            placed('dome',x,1.86,z,.85,.58,.83,p.darkLeaf);
            placed('sphere',x-.33,2.23,z,.63,.62,.63,art.foliage);
            placed('sphere',x+.34,2.28+offset,z+.06,.65,.63,.65,p.leaf);
          }else{
            placed('sphere',x-.30,1.94,z,.80,.72,.79,p.darkLeaf);
            placed('sphere',x+.30,2.03,z+.06,.76,.76,.77,art.foliage);
            placed('dome',x,2.35+offset,z-.07,.90,.47,.88,p.leaf);
          }
          [-.59,.60].forEach((dx,j)=>placed('sphere',x+dx,.66,z+(j?.24:-.24),.35,.33,.36,j?art.foliage:p.darkLeaf));
        });
        art.beds.forEach(([x,z],i)=>{
          placed('cylinder',x,.44,z,1.04,.18,.85,i%2?art.path:art.curb);
          placed('dome',x,.62,z,.78,.34,.68,i%2?p.darkLeaf:art.foliage);
          [-.23,.23].forEach((dx,j)=>placed('sphere',x+dx,.77,z,.15,.14,.15,j?p.flower:p.warmCream));
        });
        // The eight newly themed islands retain the original close-camera cabinet LOD.
        if(art.nearCabinets) [-1,1].forEach(side=>{
          placed('rbox',side*3.4,.72,.25,.62,.56,.50,p.softStone,[0,0,0],'near');
          placed('glowbox',side*3.4,.80,.71,.22,.18,.025,p.window,[0,0,0],'near');
        });
      }

      function buildEnvironment() {
        const env=DATA.environment, envRng=mulberry32(env.seed), simplex=new SimplexNoise2D(envRng);
        const terrainArt=env.terrain;
        const islandCenters=[...islandById.values()].map(island=>island.center);
        const fbm=(x,z)=>{ let sum=0,amp=1,freq=terrainArt.noiseFrequency; for(let o=0;o<terrainArt.noiseOctaves;o++){ sum+=simplex.noise2D(x*freq,z*freq)*amp; freq*=terrainArt.noiseLacunarity;amp*=terrainArt.noisePersistence; } return sum; };
        const terrainHeight=(x,z)=>{
          const radius=Math.hypot(x,z), ring=Math.exp(-Math.pow((radius-terrainArt.ringCenter)/terrainArt.ringWidth,2));
          let height=-3.2+ring*(terrainArt.ringHeight+fbm(x,z)*terrainArt.noiseAmplitude);
          height=THREE.MathUtils.lerp(height,Math.round(height/terrainArt.terraceStep)*terrainArt.terraceStep,terrainArt.terraceMix);
          height=THREE.MathUtils.lerp(height,-2.7,THREE.MathUtils.smoothstep(x*.638+z*.770,8,35)*.94);
          let nearest=Infinity;
          for(const center of islandCenters) nearest=Math.min(nearest,Math.hypot(x-center.x,z-center.z));
          height=THREE.MathUtils.lerp(env.cityTerrainClearHeight,height,THREE.MathUtils.smoothstep(nearest,...env.cityTerrainClearRadius));
          return height;
        };
        const geo=new THREE.PlaneGeometry(env.terrainSize,env.terrainSize,env.terrainSegments,env.terrainSegments);
        const pos=geo.attributes.position, colors=[];
        const low=new THREE.Color(terrainArt.low),mid=new THREE.Color(terrainArt.mid),high=new THREE.Color(terrainArt.high),color=new THREE.Color();
        for(let i=0;i<pos.count;i++){
          const x=pos.getX(i), z=-pos.getY(i), h=terrainHeight(x,z); pos.setZ(i,h);
          const t=THREE.MathUtils.clamp((h+3)/8,0,1); color.copy(t<.55?low:mid).lerp(t<.55?mid:high,t<.55?t/.55:(t-.55)/.45); colors.push(color.r,color.g,color.b);
        }
        geo.setAttribute('color',new THREE.Float32BufferAttribute(colors,3)); geo.rotateX(-Math.PI/2); geo.computeVertexNormals();
        const terrain=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({vertexColors:true,roughness:1,flatShading:true,side:THREE.DoubleSide}));
        terrain.receiveShadow=true; scene.add(terrain);

        const coniferGeo=mergeSimpleGeometries([
          transformed(new THREE.ConeGeometry(.88,.78,10),[0,.46,0]), transformed(new THREE.ConeGeometry(.76,.72,10),[0,.82,0]), transformed(new THREE.ConeGeometry(.61,.63,10),[0,1.16,0])
        ]);
        const broadGeo=mergeSimpleGeometries([
          jitteredIco(-.25,.75,0,.58), jitteredIco(.27,.82,.06,.61),
          jitteredIco(0,1.23,-.18,.54), jitteredIco(.05,1.05,.32,.47)
        ]);
        const count=innerWidth<=DATA.stage5.mobileBreakpoint?env.mobileTreeCount:env.desktopTreeCount, placements=[[],[]];
        for(let tries=0;tries<count*12 && placements[0].length+placements[1].length<count;tries++){
          const radius=THREE.MathUtils.lerp(env.treeRadius[0],env.treeRadius[1],Math.sqrt(envRng())), angle=envRng()*Math.PI*2;
          const x=Math.cos(angle)*radius,z=Math.sin(angle)*radius,h=terrainHeight(x,z);
          if(h<-.6 || [...islandById.values()].some(v=>Math.hypot(v.center.x-x,v.center.z-z)<10.5)) continue;
          const type=envRng()<env.coniferChance?0:1,scale=THREE.MathUtils.lerp(...env.treeScale,envRng());
          placements[type].push(new THREE.Matrix4().compose(new THREE.Vector3(x,h,z),new THREE.Quaternion().setFromEuler(new THREE.Euler(0,envRng()*Math.PI*2,0)),new THREE.Vector3(scale,scale,scale)));
        }
        [coniferGeo,broadGeo].forEach((treeGeo,type)=>{
          const mesh=new THREE.InstancedMesh(treeGeo,new THREE.MeshStandardMaterial({color:0xffffff,roughness:1,flatShading:true}),placements[type].length);
          placements[type].forEach((m,i)=>{mesh.setMatrixAt(i,m); mesh.setColorAt(i,new THREE.Color(env.treeColors[type?'broad':'conifer'][i%3]));});
          mesh.instanceMatrix.needsUpdate=true; mesh.castShadow=false; mesh.receiveShadow=false; scene.add(mesh);
        });

        env.mountainRings.forEach((ring,ringIndex)=>{
          const points=96, vertices=[];
          const phase=envRng()*Math.PI*2;
          const mound=(angle,band)=>{
            const back=THREE.MathUtils.smoothstep(-(Math.cos(angle)*.638+Math.sin(angle)*.770),.18,.52);
            const crest=.80+.10*Math.sin(angle*3+phase)+.055*Math.sin(angle*5-phase*.7);
            const shoulder=Math.max(0,Math.cos((band-.5)*Math.PI));
            return -2.7+ring.height*crest*shoulder*back;
          };
          for(let i=0;i<points;i++){
            const a=i/points*Math.PI*2,b=(i+1)/points*Math.PI*2;
            for(let j=0;j<4;j++){
              const t0=j/4,t1=(j+1)/4,r0=ring.radius+(t0-.5)*11,r1=ring.radius+(t1-.5)*11;
              vertices.push(Math.cos(a)*r0,mound(a,t0),Math.sin(a)*r0, Math.cos(b)*r0,mound(b,t0),Math.sin(b)*r0, Math.cos(a)*r1,mound(a,t1),Math.sin(a)*r1,
                Math.cos(b)*r0,mound(b,t0),Math.sin(b)*r0, Math.cos(b)*r1,mound(b,t1),Math.sin(b)*r1, Math.cos(a)*r1,mound(a,t1),Math.sin(a)*r1);
            }
          }
          const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.Float32BufferAttribute(vertices,3)); g.computeVertexNormals();
          const mat=new THREE.MeshBasicMaterial({color:ring.color,side:THREE.DoubleSide,fog:true}); mat.userData.ringIndex=ringIndex; silhouetteMaterials.push(mat); scene.add(new THREE.Mesh(g,mat));
        });

        const cloudGroups=[]; let puffCount=0;
        const puffLayout=[[0,0,0],[-1.22,-.17,.13],[1.14,-.18,.05],[-.46,.38,-.25],[.52,.34,-.17],[.06,-.13,.42]];
        for(let g=0;g<env.cloudGroups;g++){
          const group={x:-72+envRng()*144,y:24+envRng()*18,z:-58+envRng()*96,phase:envRng()*20,puffs:[]};
          const n=4+Math.floor(envRng()*3);
          for(let i=0;i<n;i++) group.puffs.push({x:puffLayout[i][0]+(envRng()-.5)*.24,y:puffLayout[i][1]+(envRng()-.5)*.18,z:puffLayout[i][2]+(envRng()-.5)*.22,s:i===0?1.34:.77+envRng()*.32});
          puffCount+=n; cloudGroups.push(group);
        }
        cloudMaterial=new THREE.MeshLambertMaterial({color:env.cloudColors.day,transparent:true,opacity:.74,depthWrite:false});
        const cloudMesh=new THREE.InstancedMesh(new THREE.SphereGeometry(1,12,8),cloudMaterial,puffCount);
        const updateCloudMatrices=()=>{ let index=0; for(const group of cloudGroups) for(const puff of group.puffs){ const s=puff.s; cloudMesh.setMatrixAt(index++,new THREE.Matrix4().compose(new THREE.Vector3(group.x+puff.x,group.y+puff.y,group.z+puff.z),new THREE.Quaternion(),new THREE.Vector3(s*1.13,s*.77,s*.98))); } cloudMesh.instanceMatrix.needsUpdate=true; };
        updateCloudMatrices(); cloudMesh.frustumCulled=false; scene.add(cloudMesh);
        cloudField={ update(delta){ cloudGroups.forEach(group=>{ group.x+=env.cloudSpeed*delta; if(group.x>82)group.x=-82; }); updateCloudMatrices(); } };

        env.marine.forEach(item=>{
          const [x,z]=item.position,s=item.scale;
          if(item.kind==='islet'){
            addPart('static','ico',[x,-.75,z],[3.4*s,.65*s,2.5*s],'#5c7863'); addPart('static','cone',[x,1.0,z],[.65*s,2.0*s,.65*s],DATA.palette.darkLeaf);
          } else if(item.kind==='tower'){
            addPart('static','cylinder',[x,.5,z],[.42*s,3.4*s,.42*s],DATA.palette.stone); addPart('static','torus',[x,3.25,z],[1.0*s,1.0*s,.08*s],DATA.palette.coral,null,[Math.PI/2,0,0]);
            addPart('glow','glowsphere',[x,3.35,z],[.18,.18,.18],DATA.palette.lamp);
          } else {
            addPart('static','rbox',[x,-.78,z],[2.3*s,.38*s,.78*s],DATA.palette.cream); addPart('static','box',[x,-.30,z],[.72*s,.54*s,.62*s],DATA.palette.coral);
            addPart('static','cylinder',[x+.25,.55,z],[.05*s,1.05*s,.05*s],DATA.palette.darkStone);
          }
        });

        const scatter=env.marineScatter,marineRng=mulberry32(scatter.seed),spots=env.marine.map(item=>[...item.position]);
        Object.entries(scatter.counts).forEach(([kind,count])=>{
          for(let placedCount=0,tries=0;placedCount<count&&tries<count*80;tries++){
            const radius=THREE.MathUtils.lerp(...scatter.radius,marineRng()),angle=marineRng()*Math.PI*2,x=Math.cos(angle)*radius,z=Math.sin(angle)*radius;
            if(terrainHeight(x,z)>scatter.waterDepth||islandCenters.some(c=>Math.hypot(c.x-x,c.z-z)<scatter.islandClearance)||spots.some(([sx,sz])=>Math.hypot(sx-x,sz-z)<scatter.spacing))continue;
            spots.push([x,z]);placedCount++;
            const yaw=marineRng()*Math.PI*2,fx=Math.sin(yaw),fz=Math.cos(yaw),pick=list=>list[Math.floor(marineRng()*list.length)];
            if(kind==='sailboat'){
              addPart('static','rbox',[x,-1.1,z],[1.0,.42,2.5],pick(scatter.hulls),null,[0,yaw,0]);
              addPart('static','rbox',[x,-.86,z],[.8,.1,1.8],DATA.palette.clay,null,[0,yaw,0]);
              addPart('static','cylinder',[x,.31,z],[.07,2.4,.07],DATA.palette.darkStone);
              addPart('static','prism',[x,-.22,z],[1.5,.05,2.2],pick(scatter.sails),null,[-Math.PI/2,yaw-Math.PI/2,0,'YXZ']);
            }else if(kind==='sandbar'){
              const s=.8+marineRng()*.6;
              addPart('static','ico',[x,-1.3,z],[3.2*s,.5,2.3*s],scatter.sand,null,[0,yaw,0]);
              addPart('static','sphere',[x+fx*.4,-.95,z+fz*.4],[1.3*s,.35,1.0*s],DATA.palette.leaf);
              addPart('static','cylinder',[x-fx*.3,-.55,z-fz*.3],[.12,.9,.12],DATA.palette.trunk);
              addPart('static','sphere',[x-fx*.3,.05,z-fz*.3],[.8,.65,.8],DATA.palette.darkLeaf);
            }else{
              addPart('static','cylinder',[x,-1.08,z],[.34,.42,.34],DATA.palette.coral);
              addPart('static','sphere',[x,-.82,z],[.24,.22,.24],'#fff8f4');
              addPart('glow','glowsphere',[x,-.68,z],[.12,.12,.12],DATA.palette.lamp);
            }
          }
        });

        function transformed(geometry,translation){ geometry.applyMatrix4(new THREE.Matrix4().makeTranslation(...translation)); return geometry; }
        function jitteredIco(x,y,z,size){
          const geometry=new THREE.IcosahedronGeometry(1,1),j=()=>1+(envRng()-.5)*.12;
          geometry.applyMatrix4(new THREE.Matrix4().compose(new THREE.Vector3(x+(envRng()-.5)*.14,y+(envRng()-.5)*.12,z+(envRng()-.5)*.14),new THREE.Quaternion(),new THREE.Vector3(size*j(),size*j(),size*j())));
          return geometry;
        }
        function mergeSimpleGeometries(geometries){
          const positions=[],normals=[];
          geometries.forEach(g=>{ const n=g.index?g.toNonIndexed():g; positions.push(...n.attributes.position.array); normals.push(...n.attributes.normal.array); });
          const merged=new THREE.BufferGeometry(); merged.setAttribute('position',new THREE.Float32BufferAttribute(positions,3)); merged.setAttribute('normal',new THREE.Float32BufferAttribute(normals,3)); return merged;
        }
      }

      function instantiatePartLibrary() {
        const geometries={
          box:new THREE.BoxGeometry(1,1,1), rbox:makeRoundedBoxGeometry(), cylinder:new THREE.CylinderGeometry(.5,.5,1,12),
          cone:new THREE.ConeGeometry(.5,1,12), sphere:new THREE.SphereGeometry(.5,12,8), ico:new THREE.IcosahedronGeometry(.5,1),
          dome:new THREE.SphereGeometry(.5,12,7,0,Math.PI*2,0,Math.PI/2), torus:new THREE.TorusGeometry(.5,.12,7,14),
          prism:new THREE.CylinderGeometry(.5,.5,1,3), glowbox:new THREE.BoxGeometry(1,1,1), glowsphere:new THREE.SphereGeometry(.5,9,6)
        };
        Object.entries(partBuckets).forEach(([bucket,parts])=>{
          const byKind=new Map(); parts.forEach((part,index)=>{ if(!byKind.has(part.kind))byKind.set(part.kind,[]); byKind.get(part.kind).push({part,index}); });
          byKind.forEach((entries,kind)=>{
            const glow=bucket==='glow' || kind.startsWith('glow');
            const material=glow
              ? new THREE.MeshStandardMaterial({color:0xffffff,emissive:0xffd59a,emissiveIntensity:0,transparent:true,opacity:.10,depthWrite:false,roughness:DATA.artDirection.glowRoughness})
              : new THREE.MeshStandardMaterial({color:0xffffff,roughness:DATA.artDirection.matteRoughness,metalness:0});
            if(glow)nightMaterials.push(material);
            const mesh=new THREE.InstancedMesh(geometries[kind],material,entries.length);
            const lookup=new Map();
            mesh.userData.originalColors=[];
            entries.forEach(({part,index},instanceIndex)=>{
              const originalColor=new THREE.Color(part.color);
              mesh.setMatrixAt(instanceIndex,part.matrix); mesh.setColorAt(instanceIndex,originalColor);
              mesh.userData.originalColors[instanceIndex]=originalColor.clone();
              const owner=partOwners[bucket][index];
              if(owner){
                lookup.set(instanceIndex,owner);
                if(!serviceInstances.has(owner))serviceInstances.set(owner,[]);
                serviceInstances.get(owner).push({mesh,instanceIndex,kind,originalColor:originalColor.clone()});
              }
            });
            mesh.instanceMatrix.needsUpdate=true; if(mesh.instanceColor)mesh.instanceColor.needsUpdate=true;
            mesh.castShadow=!glow; mesh.receiveShadow=!glow; mesh.userData={partKind:kind,bucket}; scene.add(mesh);
            mesh.userData.originalColors=entries.map(({part})=>new THREE.Color(part.color));
            if(lookup.size){instanceLookup.set(mesh,lookup);selectableServiceMeshes.push(mesh);}
            if(bucket==='near')nearMeshes.push(mesh); stage2DrawCalls++;
          });
        });
      }

      function makeRoundedBoxGeometry() {
        const geometry=new THREE.BoxGeometry(1,1,1,2,2,2), p=geometry.attributes.position, v=new THREE.Vector3(), core=new THREE.Vector3(), delta=new THREE.Vector3();
        for(let i=0;i<p.count;i++){
          v.fromBufferAttribute(p,i); core.set(THREE.MathUtils.clamp(v.x,-.32,.32),THREE.MathUtils.clamp(v.y,-.32,.32),THREE.MathUtils.clamp(v.z,-.32,.32));
          delta.copy(v).sub(core).normalize().multiplyScalar(.18); v.copy(core).add(delta); p.setXYZ(i,v.x,v.y,v.z);
        }
        geometry.computeVertexNormals(); return geometry;
      }

      function dijkstra(startId, endId) {
        if (!roadGraph.has(startId) || !roadGraph.has(endId)) return [];
        const dist = new Map([...roadGraph.keys()].map(id => [id, Infinity]));
        const prev = new Map(); const unvisited = new Set(roadGraph.keys()); dist.set(startId,0);
        while(unvisited.size) {
          let current=null, best=Infinity;
          for(const id of unvisited) if(dist.get(id)<best){ best=dist.get(id); current=id; }
          if(current===null || current===endId) break;
          unvisited.delete(current);
          const node=roadGraph.get(current);
          for(const next of node.links) {
            if(!unvisited.has(next)) continue;
            const alt=best+node.position.distanceTo(roadGraph.get(next).position);
            if(alt<dist.get(next)){ dist.set(next,alt); prev.set(next,current); }
          }
        }
        if(startId!==endId && !prev.has(endId)) return [];
        const path=[]; let cursor=endId;
        while(cursor){ path.unshift(cursor); if(cursor===startId) break; cursor=prev.get(cursor); }
        return path;
      }

      const selection={type:null,id:null,domainId:null,flowId:null,serviceIds:new Set(),visibleFlowIds:new Set(),walkerId:null};
      const ui={
        catalog:document.querySelector('#catalog-panel'),catalogContent:document.querySelector('#catalog-content'),search:document.querySelector('#catalog-search'),
        detail:document.querySelector('#detail-panel'),detailContent:document.querySelector('#detail-content'),listButton:document.querySelector('#list-btn'),
        period:document.querySelector('#period-name'),pause:document.querySelector('#pause-btn'),bird:document.querySelector('#bird-btn'),help:document.querySelector('#help-dialog'),
        labels:document.querySelector('#labels-btn'),packets:document.querySelector('#packets-btn'),apiLines:document.querySelector('#api-lines-btn'),logs:document.querySelector('#logs-btn'),
        legend:document.querySelector('#flow-legend'),logPanel:document.querySelector('#log-panel'),logList:document.querySelector('#log-list'),logFilter:document.querySelector('#log-filter'),liveDot:document.querySelector('#live-dot'),liveState:document.querySelector('#live-state'),
        hud:document.querySelector('.hud'),hudToggle:document.querySelector('#hud-toggle'),detailBack:document.querySelector('#detail-back'),tutorialStep:document.querySelector('#tutorial-step'),tutorialPrev:document.querySelector('#tutorial-prev'),tutorialSkip:document.querySelector('#tutorial-skip'),tutorialNext:document.querySelector('#tutorial-next')
      };
      const raycaster=new THREE.Raycaster(),pointer=new THREE.Vector2();
      const coral=new THREE.Color(DATA.palette.coral),highYellow=new THREE.Color('#efd36b');
      const metricLabels={rpm:tr('metricRpm'),p95:tr('metricP95'),availability:tr('metricAvailability')};
      const sortedCycles=DATA.dayCycle.map(period=>({...period,minute:timeToMinutes(period.start)})).sort((a,b)=>a.minute-b.minute);
      let activeTab='domains',isPaused=false,birdView=false,cameraFlight=null,currentPeriod=null,highlightSignature='',pointerStart=null,lastCollisionCheck=0,needsRender=true,tutorialIndex=0,helpReturnFocus=null,pageHidden=document.hidden,renderedFrames=0;
      let currentHighLoad=new Set();
      let labelsOn=DATA.stage4.defaults.labels,packetsOn=DATA.stage4.defaults.packets,apiLinesOn=DATA.stage4.defaults.apiLines,logsOn=DATA.stage4.defaults.logs;
      let walkerMeshes=null,flowPatternTime=0,lastLogDomUpdate=0,logDirty=true;
      const flowRuntime=new Map(),queueSlots=new Map(),arrivalPulse=new Map(),trafficRng=mulberry32(DATA.stage4.seed+1);
      let serviceLampMesh=null,serviceLampIds=[];
      const logEntries=[];
      let previewTarget=null;

      function initStage3UI(){
        createServicePins();
        DATA.stage3.timePresets.forEach(minutes=>{
          const button=document.createElement('button');button.type='button';button.className='time-btn';button.textContent=formatTime(minutes);button.dataset.minutes=String(minutes);
          button.setAttribute('aria-label',`${tr('jumpTo')} ${formatTime(minutes)}`);document.querySelector('#time-presets').appendChild(button);
        });
        renderCatalog(); updatePauseButton();
        document.querySelectorAll('[data-ui]').forEach(element=>{element.addEventListener('pointerdown',event=>event.stopPropagation());element.addEventListener('pointerup',event=>event.stopPropagation());});
        document.querySelectorAll('[role="tab"]').forEach(button=>button.addEventListener('click',()=>{activeTab=button.dataset.tab;document.querySelectorAll('[role="tab"]').forEach(tab=>tab.setAttribute('aria-selected',String(tab===button)));renderCatalog();}));
        ui.search.addEventListener('input',renderCatalog);
        ui.catalogContent.addEventListener('click',handleDataAction);ui.detailContent.addEventListener('click',handleDataAction);
        document.querySelector('#catalog-close').addEventListener('click',()=>toggleCatalog(false));
        ui.listButton.addEventListener('click',()=>toggleCatalog(!ui.catalog.classList.contains('is-open')));
        document.querySelector('#detail-close').addEventListener('click',()=>clearSelection(false));
        ui.detailBack.addEventListener('click',()=>{ui.detail.classList.remove('is-open');toggleCatalog(true);});
        document.querySelector('#overview-btn').addEventListener('click',()=>clearSelection(true));
        document.querySelector('#help-btn').addEventListener('click',event=>openTutorial(event.currentTarget));
        document.querySelector('#help-close').addEventListener('click',()=>ui.help.close());
        ui.tutorialPrev.addEventListener('click',()=>{tutorialIndex=Math.max(0,tutorialIndex-1);renderTutorial();});
        ui.tutorialSkip.addEventListener('click',completeTutorial);ui.tutorialNext.addEventListener('click',()=>{if(tutorialIndex<2){tutorialIndex++;renderTutorial();}else completeTutorial();});
        ui.help.addEventListener('close',()=>{helpReturnFocus?.focus();helpReturnFocus=null;});
        ui.help.addEventListener('keydown',event=>{if(event.key!=='Tab')return;const focusable=[...ui.help.querySelectorAll('button:not([hidden]):not(:disabled),[tabindex="0"]')];if(!focusable.length)return;const first=focusable[0],last=focusable.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}});
        document.querySelector('#time-presets').addEventListener('click',event=>{const button=event.target.closest('[data-minutes]');if(button){simulatedMinutes=Number(button.dataset.minutes);updateDaylight(simulatedMinutes);}});
        ui.pause.addEventListener('click',()=>{if(reducedMotion)return;isPaused=!isPaused;updatePauseButton();updateLiveState();needsRender=true;});
        ui.bird.addEventListener('click',()=>setBirdView(!birdView));
        ui.labels.addEventListener('click',()=>setStage4Toggle('labels',!labelsOn));
        ui.packets.addEventListener('click',()=>setStage4Toggle('packets',!packetsOn));
        ui.apiLines.addEventListener('click',()=>setStage4Toggle('apiLines',!apiLinesOn));
        ui.logs.addEventListener('click',()=>setStage4Toggle('logs',!logsOn));
        ui.hudToggle.addEventListener('click',()=>toggleMobileHud(!ui.hud.classList.contains('is-open')));
        document.querySelector('#log-close').addEventListener('click',()=>setStage4Toggle('logs',false));
        ui.logFilter.addEventListener('change',()=>{logDirty=true;renderLogs(performance.now(),true);});
        renderer.domElement.addEventListener('pointerdown',onScenePointerDown);renderer.domElement.addEventListener('pointerup',onScenePointerUp);renderer.domElement.addEventListener('pointercancel',()=>pointerStart=null);
        controls.addEventListener('change',()=>{needsRender=true;});
        window.addEventListener('keydown',onKeyDown);
        document.querySelectorAll('.sheet-handle').forEach(setupSheetHandle);
        window.addEventListener('resize',syncResponsivePanels);
        document.addEventListener('visibilitychange',()=>{pageHidden=document.hidden;lastTime=performance.now();if(!pageHidden){needsRender=true;logDirty=true;}});
      }

      function isMobileLayout(){return innerWidth<=DATA.stage5.mobileBreakpoint;}
      function closeMobileOverlays(except){if(!isMobileLayout())return;if(except!=='catalog')ui.catalog.classList.remove('is-open');if(except!=='detail')ui.detail.classList.remove('is-open');if(except!=='hud')toggleMobileHud(false);if(except!=='logs'&&logsOn)setStage4Toggle('logs',false);}
      function toggleMobileHud(open){ui.hud.classList.toggle('is-open',open);ui.hudToggle.setAttribute('aria-expanded',String(open));if(open)closeMobileOverlays('hud');lastCollisionCheck=0;needsRender=true;}
      function syncResponsivePanels(){lastCollisionCheck=0;needsRender=true;if(!isMobileLayout()){ui.hud.classList.remove('is-open');ui.hudToggle.setAttribute('aria-expanded','false');document.querySelectorAll('.sheet-handle').forEach(handle=>handle.setAttribute('aria-expanded','false'));[ui.catalog,ui.detail].forEach(panel=>{panel.style.removeProperty('--sheet-height');panel.classList.remove('is-expanded');});}else if(ui.detail.classList.contains('is-open'))ui.catalog.classList.remove('is-open');}
      function setupSheetHandle(handle){
        const panel=handle.closest('aside'),defaultHeight=Number(handle.dataset.sheet==='catalog'?DATA.stage5.catalogHeight:DATA.stage5.detailHeight);let drag=null;
        const setExpanded=expanded=>{panel.style.setProperty('--sheet-height',`${expanded?100:defaultHeight}dvh`);panel.classList.toggle('is-expanded',expanded);handle.setAttribute('aria-expanded',String(expanded));handle.setAttribute('aria-label',`${expanded?tr('collapse'):tr('expand')} ${handle.dataset.sheet==='catalog'?tr('directory'):tr('detail')}`);};
        const finish=event=>{if(!drag)return;const moved=Math.abs(event.clientY-drag.startY);let expanded=drag.height>defaultHeight+(100-defaultHeight)/2;if(moved<=6)expanded=!drag.wasExpanded;setExpanded(expanded);try{handle.releasePointerCapture(event.pointerId);}catch{}drag=null;lastCollisionCheck=0;needsRender=true;};
        const cancel=event=>{if(!drag)return;setExpanded(drag.wasExpanded);try{handle.releasePointerCapture(event.pointerId);}catch{}drag=null;needsRender=true;};
        handle.addEventListener('pointerdown',event=>{if(!isMobileLayout())return;drag={startY:event.clientY,startHeight:panel.getBoundingClientRect().height,height:defaultHeight,wasExpanded:handle.getAttribute('aria-expanded')==='true'};handle.setPointerCapture(event.pointerId);event.preventDefault();});
        handle.addEventListener('pointermove',event=>{if(!drag)return;const px=THREE.MathUtils.clamp(drag.startHeight+drag.startY-event.clientY,innerHeight*.25,innerHeight);drag.height=px/innerHeight*100;panel.style.setProperty('--sheet-height',`${drag.height}dvh`);needsRender=true;});
        handle.addEventListener('pointerup',finish);handle.addEventListener('pointercancel',cancel);
        handle.addEventListener('click',event=>{if(!isMobileLayout()||event.detail!==0)return;setExpanded(handle.getAttribute('aria-expanded')!=='true');needsRender=true;});
      }
      function readTutorialSeen(){try{return localStorage.getItem(DATA.stage5.tutorialStorage)==='1';}catch{return false;}}
      function rememberTutorial(){try{localStorage.setItem(DATA.stage5.tutorialStorage,'1');}catch(error){console.info('Tutorial preference could not be saved.',error);}}
      function openTutorial(trigger){helpReturnFocus=trigger||document.activeElement;tutorialIndex=0;renderTutorial();if(!ui.help.open)ui.help.showModal();queueMicrotask(()=>ui.tutorialNext.focus());}
      function completeTutorial(){rememberTutorial();ui.help.close();}
      function renderTutorial(){const steps=[['tutorial1Title',isMobileLayout()?'tutorial1Touch':'tutorial1'],['tutorial2Title','tutorial2'],['tutorial3Title','tutorial3']],step=steps[tutorialIndex];ui.tutorialStep.innerHTML=`<strong>${tr(step[0])}</strong><p>${tr(step[1])}</p>`;document.querySelectorAll('#tutorial-progress i').forEach((dot,index)=>dot.classList.toggle('is-active',index<=tutorialIndex));ui.tutorialPrev.hidden=tutorialIndex===0;ui.tutorialNext.textContent=tutorialIndex===2?tr('startExplore'):tr('next');ui.tutorialNext.setAttribute('aria-label',ui.tutorialNext.textContent);}

      function handleDataAction(event){
        const target=event.target.closest('[data-service],[data-domain],[data-flow]');if(!target)return;
        if(target.dataset.service)selectItem(target.dataset.service);else if(target.dataset.domain)selectIsland(target.dataset.domain);else if(target.dataset.flow)selectFlow(target.dataset.flow);
      }
      function toggleCatalog(open){if(open&&logsOn&&innerWidth<=1100)setStage4Toggle('logs',false);ui.catalog.classList.toggle('is-open',open);ui.listButton.setAttribute('aria-pressed',String(open));ui.listButton.setAttribute('aria-expanded',String(open));if(open&&isMobileLayout())ui.detail.classList.remove('is-open');lastCollisionCheck=0;needsRender=true;}
      function renderCatalog(){
        const query=ui.search.value.trim().toLocaleLowerCase(UI_LANG==='en'?'en':'zh-Hant');let html='';
        if(activeTab==='domains'){
          DATA.domains.forEach(domain=>{
            const domainMatch=`${localize(domain)} ${domain.id}`.toLocaleLowerCase(UI_LANG==='en'?'en':'zh-Hant').includes(query);
            const services=domain.services.filter(service=>domainMatch||`${localize(service)} ${localize(service,'description')} ${service.id}`.toLocaleLowerCase(UI_LANG==='en'?'en':'zh-Hant').includes(query));
            if(query&&!domainMatch&&!services.length)return;
            html+=`<details class="domain-group" ${query||selection.domainId===domain.id?'open':''} style="--domain-color:${domain.color}"><summary><span class="domain-dot"></span><strong>${escapeHTML(localize(domain))}</strong><small>${domain.services.length}</small></summary><button class="domain-select" type="button" data-domain="${domain.id}" aria-label="${tr('selectDomain')} ${escapeHTML(localize(domain))}">${tr('islandSummary')} · ${domain.services.length} ${tr('serviceUnit')}</button>`;
            services.forEach((service,index)=>{html+=`<button class="service-row" type="button" data-service="${service.id}" aria-label="${tr('selectService')} ${escapeHTML(localize(service))}"><span class="node-no">${String(index+1).padStart(2,'0')}</span><span><strong>${escapeHTML(localize(service))}</strong><small>${escapeHTML(localize(service,'description'))}</small></span><span class="status-wrap"><i class="status-dot ${service.status}"></i>${tr(service.status)}</span></button>`;});
            html+='</details>';
          });
        }else{
          DATA.flows.filter(flow=>{const from=serviceById.get(flow.from),to=serviceById.get(flow.to);return !query||`${localize(flow)} ${localize(from||{},'name')} ${localize(to||{},'name')} ${localize(flow,'level')} ${localize(flow,'payload')}`.toLocaleLowerCase(UI_LANG==='en'?'en':'zh-Hant').includes(query);}).forEach(flow=>{const from=serviceById.get(flow.from),to=serviceById.get(flow.to);html+=`<button class="flow-row" type="button" data-flow="${flow.id}" aria-label="${tr('selectFlow')} ${escapeHTML(localize(flow))}"><span><strong>${escapeHTML(localize(flow))}</strong><small class="flow-route">${escapeHTML(from?localize(from):flow.from)} → ${escapeHTML(to?localize(to):flow.to)}</small></span><span class="chip">${escapeHTML(localize(flow,'level'))}</span></button>`;});
        }
        ui.catalogContent.innerHTML=html||`<div class="empty-state">${tr('noResults')}</div>`;
      }

      function selectIsland(domainId){
        const domain=DATA.domains.find(item=>item.id===domainId);if(!domain)return;
        setSelection('island',domain.id,domain.id,null,new Set(domain.services.map(service=>service.id)),new Set(DATA.flows.filter(flow=>domainByService.get(flow.from)?.id===domain.id||domainByService.get(flow.to)?.id===domain.id).map(flow=>flow.id)));
        showIslandCard(domain);showPins([domain.id]);focusIsland(domain);renderCatalog();updateFlowVisibility();
      }
      function selectItem(serviceId){
        const service=serviceById.get(serviceId),domain=domainByService.get(serviceId);if(!service||!domain)return;
        const flows=DATA.flows.filter(flow=>flow.from===serviceId||flow.to===serviceId);
        setSelection('service',serviceId,domain.id,null,new Set([serviceId]),new Set(flows.map(flow=>flow.id)));
        showServiceCard(service,domain);showPins([domain.id]);focusService(serviceId);renderCatalog();updateFlowVisibility();
      }
      function selectFlow(flowId){
        const flow=DATA.flows.find(item=>item.id===flowId);if(!flow)return;
        const domains=[domainByService.get(flow.from)?.id,domainByService.get(flow.to)?.id].filter(Boolean);
        setSelection('flow',flow.id,null,flow.id,new Set([flow.from,flow.to]),new Set([flow.id]));
        showFlowCard(flow);showPins(domains);focusFlow(flow);renderCatalog();updateFlowVisibility();
      }
      function selectWalker(walkerId){const walker=walkerById.get(walkerId);if(!walker?.active)return false;const flow=walker.flow,domains=[domainByService.get(flow.from)?.id,domainByService.get(flow.to)?.id].filter(Boolean);setSelection('walker',walker.id,null,flow.id,new Set([flow.from,flow.to]),new Set([flow.id]));selection.walkerId=walker.id;showFlowCard(flow,walker);showPins(domains);focusWalker(walker);renderCatalog();updateFlowVisibility();return true;}
      function setSelection(type,id,domainId,flowId,serviceIds,visibleFlowIds){selection.type=type;selection.id=id;selection.domainId=domainId;selection.flowId=flowId;selection.walkerId=null;selection.serviceIds=serviceIds;selection.visibleFlowIds=visibleFlowIds;updateHighlights();updateIslandLabels();needsRender=true;}
      function clearSelection(returnOverview=false){selection.type=selection.id=selection.domainId=selection.flowId=selection.walkerId=null;selection.serviceIds=new Set();selection.visibleFlowIds=new Set();ui.detail.classList.remove('is-open');updateHighlights();updateIslandLabels();showPins([]);renderCatalog();updateFlowVisibility();needsRender=true;if(returnOverview)focusOverview();}

      function updateHighlights(){
        const high=currentHighLoad,selected=selection.serviceIds;
        const pulseStep=high.size?Math.floor(flowPatternTime*DATA.stage4.traffic.highLoadPulse.updatesPerSecond):0;
        const signature=`${[...high].sort()}|${[...selected].sort()}|${pulseStep}`;if(signature===highlightSignature)return;highlightSignature=signature;
        const touched=new Set();
        serviceInstances.forEach((refs,serviceId)=>refs.forEach(ref=>{const color=ref.originalColor.clone();if(high.has(serviceId)){const pulse=DATA.stage4.traffic.highLoadPulse;color.lerp(highYellow,DATA.stage3.highLoadMix+pulse.amplitude*Math.sin(flowPatternTime*pulse.speed+serviceId.length));}if(selected.has(serviceId))color.lerp(coral,DATA.stage3.selectionMix);ref.mesh.setColorAt(ref.instanceIndex,color);touched.add(ref.mesh);}));
        touched.forEach(mesh=>{if(mesh.instanceColor)mesh.instanceColor.needsUpdate=true;});
      }
      function updateIslandLabels(){const selectedDomains=new Set();if(selection.domainId)selectedDomains.add(selection.domainId);if(selection.flowId){const flow=DATA.flows.find(item=>item.id===selection.flowId);if(flow){selectedDomains.add(domainByService.get(flow.from)?.id);selectedDomains.add(domainByService.get(flow.to)?.id);}}islandLabels.forEach(({element},domainId)=>{const selected=selectedDomains.has(domainId);element.classList.toggle('is-selected',selected);element.classList.toggle('is-muted',Boolean(selection.type)&&!selected);});}
      function showPins(domainIds){
        const visible=new Set(domainIds);servicePins.forEach((pin,serviceId)=>{const show=visible.has(domainByService.get(serviceId)?.id);pin.object.visible=show;servicePinLines.get(serviceId).visible=show;pin.element.classList.remove('is-collision-hidden','is-compact');});lastCollisionCheck=0;
      }
      function createServicePins(){
        DATA.domains.forEach(domain=>domain.services.forEach((service,index)=>{const position=servicePositions.get(service.id);if(!position)return;const element=document.createElement('div');element.className='service-pin';element.innerHTML=`<b>${String(index+1).padStart(2,'0')}</b><span>${escapeHTML(localize(service))}</span>`;element.dataset.full=localize(service);
          const object=new CSS2DObject(element);object.position.copy(position).add(new THREE.Vector3(0,3.35,0));object.visible=false;scene.add(object);servicePins.set(service.id,{element,object});
          const geometry=new THREE.BufferGeometry().setFromPoints([position.clone().add(new THREE.Vector3(0,.7,0)),position.clone().add(new THREE.Vector3(0,3.18,0))]);const line=new THREE.Line(geometry,new THREE.LineBasicMaterial({color:DATA.palette.coral,transparent:true,opacity:.72,depthTest:false}));line.renderOrder=30;line.visible=false;scene.add(line);servicePinLines.set(service.id,line);
        }));
      }

      function showIslandCard(domain){
        const flows=DATA.flows.filter(flow=>domainByService.get(flow.from)?.id===domain.id||domainByService.get(flow.to)?.id===domain.id);
        ui.detailContent.innerHTML=`<span class="eyebrow">${tr('islandSummary')}</span><div class="detail-icon">⬡</div><h2>${escapeHTML(localize(domain))}</h2><p>${domain.services.length} ${tr('serviceUnit')} · axial (${domain.axial.join(', ')})</p><h3>${tr('nodes')}</h3><div class="node-list">${domain.services.map((service,index)=>`<button type="button" data-service="${service.id}"><span class="chip">${String(index+1).padStart(2,'0')}</span>${escapeHTML(localize(service))}</button>`).join('')}</div><h3>${tr('connections')}</h3><div class="chips">${flows.map(flow=>`<button type="button" class="chip" data-flow="${flow.id}">${escapeHTML(localize(flow))}</button>`).join('')}</div>`;openDetail();
      }
      function showServiceCard(service,domain){
        const metrics=Object.entries(service.metrics).slice(0,3),flows=DATA.flows.filter(flow=>flow.from===service.id||flow.to===service.id);
        ui.detailContent.innerHTML=`<span class="eyebrow">${escapeHTML(localize(domain))}</span><div class="thumbnail-wrap"><canvas id="service-thumbnail" width="160" height="160" aria-label="${escapeHTML(localize(service))} ${tr('thumbnail')}"></canvas></div><h2>${escapeHTML(localize(service))}</h2><div class="chips"><span class="chip">${tr(service.status)}</span>${currentPeriod?.highLoad?.includes(service.id)?`<span class="chip">${tr('highLoad')}</span>`:''}</div><p>${escapeHTML(localize(service,'description'))}</p><h3>${tr('metrics')}</h3><div class="metric-grid">${metrics.map(([key,value])=>`<div class="metric"><strong>${escapeHTML(String(value))}</strong><small>${escapeHTML(metricLabels[key]||key)}</small></div>`).join('')}</div><h3>${tr('connections')}</h3><div class="chips">${flows.length?flows.map(flow=>`<button type="button" class="chip" data-flow="${flow.id}">${escapeHTML(localize(flow))}</button>`).join(''):`<span class="chip">—</span>`}</div>`;openDetail();renderServiceThumbnail(service.id,document.querySelector('#service-thumbnail'));
      }
      function showFlowCard(flow,walker=null){const from=serviceById.get(flow.from),to=serviceById.get(flow.to),direction=walker?(walker.state==='queued'?tr('queueing'):walker.state==='handoff'?tr('processing'):walker.direction>0?tr('outbound'):tr('returning')):null;ui.detailContent.innerHTML=`<span class="eyebrow">${walker?tr('walker'):tr('connections')}</span><h2>${escapeHTML(localize(flow))}</h2><div class="flow-hero"><span>${escapeHTML(from?localize(from):flow.from)}</span><strong>→ ${escapeHTML(to?localize(to):flow.to)}</strong><span class="chip">${tr(flow.mode)}</span></div><div class="metric-grid"><div class="metric"><strong>${escapeHTML(flow.protocol)}</strong><small>${tr('protocol')}</small></div><div class="metric"><strong>${escapeHTML(String(flow.rpm))}</strong><small>RPM</small></div><div class="metric"><strong>${escapeHTML(localize(flow,'level'))}</strong><small>${tr('level')}</small></div></div><p><b>${tr('payload')}：</b>${escapeHTML(localize(flow,'payload'))}</p><p><b>${tr('actor')}：</b>${escapeHTML(localize(flow,'actor'))}</p>${walker?`<p><b>${tr('direction')}：</b>${direction}</p>`:''}<div class="chips"><button type="button" class="chip" data-service="${flow.from}">${tr('from')} · ${escapeHTML(from?localize(from):flow.from)}</button><button type="button" class="chip" data-service="${flow.to}">${tr('to')} · ${escapeHTML(to?localize(to):flow.to)}</button></div>`;openDetail();}
      function openDetail(){if(isMobileLayout())closeMobileOverlays('detail');ui.detail.classList.add('is-open');if(isMobileLayout())toggleCatalog(false);lastCollisionCheck=0;needsRender=true;}

      function renderServiceThumbnail(serviceId,canvas){
        const refs=serviceInstances.get(serviceId);if(!refs||!canvas)return;const size=160,previewScene=new THREE.Scene();previewScene.background=new THREE.Color('#f4ece4');const previewCamera=new THREE.PerspectiveCamera(34,1,.1,30);previewCamera.position.set(4.1,3.3,5.2);previewCamera.lookAt(0,1,0);previewScene.add(new THREE.HemisphereLight(0xffffff,0x50635c,1.4));const key=new THREE.DirectionalLight(0xfff0d5,2.2);key.position.set(4,7,5);previewScene.add(key);
