      function segmentDistanceXZ(a,b,p){const dx=b.x-a.x,dz=b.z-a.z,length=dx*dx+dz*dz;if(!length)return Math.hypot(p.x-a.x,p.z-a.z);const t=THREE.MathUtils.clamp(((p.x-a.x)*dx+(p.z-a.z)*dz)/length,0,1);return Math.hypot(p.x-a.x-dx*t,p.z-a.z-dz*t);}
      function chooseAccessNode(serviceId){const service=servicePositions.get(serviceId),domain=domainByService.get(serviceId);if(!service||!domain)return null;const blockers=domain.services.filter(item=>item.id!==serviceId).map(item=>servicePositions.get(item.id));const candidates=[...roadGraph.values()].filter(node=>node.id.startsWith(`${domain.id}:ring:`)).map(node=>({node,blocked:blockers.some(point=>segmentDistanceXZ(service,node.position,point)<.78),distance:service.distanceTo(node.position)})).sort((a,b)=>(a.blocked-b.blocked)||a.distance-b.distance);return candidates[0]?.node||null;}
      function buildFlowRoute(flow){const from=servicePositions.get(flow.from),to=servicePositions.get(flow.to);if(!from||!to)return{error:`${tr('routeError')}：${flow.id} (${!from?flow.from:flow.to})`};const start=chooseAccessNode(flow.from),end=chooseAccessNode(flow.to);if(!start||!end)return{error:`${tr('routeError')}：${flow.id} (access)`};const nodeIds=dijkstra(start.id,end.id);if(!nodeIds.length)return{error:`${tr('routeError')}：${flow.id} (${start.id} → ${end.id})`};const y=DATA.stage4.routeHeight,points=[from.clone().setY(y),...nodeIds.map(id=>roadGraph.get(id).position.clone().setY(y)),to.clone().setY(y)];const compact=points.filter((point,index)=>!index||point.distanceTo(points[index-1])>.02);const curve=new PolylineCurve(compact);return{flow,points:compact,curve,length:curve.length,nodeIds};}
