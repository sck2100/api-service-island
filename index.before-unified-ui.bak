      function nearbyFlow(x,y,rect){let nearest=null,best=7;flowMeshes.forEach((mesh,flowId)=>{if(!mesh.visible)return;const route=flowRoutes.get(flowId);for(let i=1;i<route.points.length;i++){const a=screenPoint(route.points[i-1],rect),b=screenPoint(route.points[i],rect);if(!a||!b)continue;const distance=screenSegmentDistance(x,y,a,b);if(distance<best){best=distance;nearest=flowId;}}});return nearest;}
      function onScenePointerUp(event){if(!pointerStart||pointerStart.id!==event.pointerId)return;const distance=Math.hypot(event.clientX-pointerStart.x,event.clientY-pointerStart.y);pointerStart=null;if(distance>DATA.stage3.pointerTolerance)return;const rect=renderer.domElement.getBoundingClientRect(),walker=nearbyWalker(event.clientX,event.clientY,rect);if(walker){selectWalker(walker.id);return;}const flowId=nearbyFlow(event.clientX,event.clientY,rect);if(flowId){selectFlow(flowId);return;}pointer.set(((event.clientX-rect.left)/rect.width)*2-1,-((event.clientY-rect.top)/rect.height)*2+1);raycaster.setFromCamera(pointer,camera);const hits=raycaster.intersectObjects([...walkerPickMeshes.filter(mesh=>mesh.visible),...flowPickMeshes.filter(mesh=>mesh.visible),...selectableServiceMeshes,...islandPickMeshes],false);for(const hit of hits){if(hit.object.isInstancedMesh&&Number.isInteger(hit.instanceId)){const walkerId=walkerInstanceLookup.get(hit.object)?.get(hit.instanceId);if(walkerId&&selectWalker(walkerId))return;const serviceId=instanceLookup.get(hit.object)?.get(hit.instanceId);if(serviceId){selectItem(serviceId);return;}}if(hit.object.userData.flowId){selectFlow(hit.object.userData.flowId);return;}if(hit.object.userData.domainId){selectIsland(hit.object.userData.domainId);return;}}}
      function onKeyDown(event){const target=event.target;if(target?.closest?.('input,textarea,select,button,[role="tab"],[contenteditable="true"]'))return;if(event.key==='Escape'){if(ui.help.open)ui.help.close();else if(logsOn)setStage4Toggle('logs',false);else if(isMobileLayout()&&ui.hud.classList.contains('is-open'))toggleMobileHud(false);else if(ui.detail.classList.contains('is-open'))ui.detail.classList.remove('is-open');else if(isMobileLayout()&&ui.catalog.classList.contains('is-open'))toggleCatalog(false);else clearSelection(false);return;}if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key))return;event.preventDefault();cancelCameraFlight();const offset=camera.position.clone().sub(controls.target),spherical=new THREE.Spherical().setFromVector3(offset);if(event.key==='ArrowLeft')spherical.theta-=.09;if(event.key==='ArrowRight')spherical.theta+=.09;if(event.key==='ArrowUp')spherical.phi=Math.max(.12,spherical.phi-.07);if(event.key==='ArrowDown')spherical.phi=Math.min(controls.maxPolarAngle,spherical.phi+.07);camera.position.copy(controls.target).add(new THREE.Vector3().setFromSpherical(spherical));controls.update();needsRender=true;}

      function updatePeriodAndLoad(minutes){let period=sortedCycles[sortedCycles.length-1];for(const candidate of sortedCycles)if(minutes>=candidate.minute)period=candidate;if(currentPeriod?.id===period.id)return;currentPeriod=period;currentHighLoad=new Set(period.highLoad);ui.period.textContent=localize(period,'label');applyTrafficPeriod(period);updateHighlights();if(selection.type==='service')showServiceCard(serviceById.get(selection.id),domainByService.get(selection.id));}
