<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#db6a41">
  <link rel="icon" href="data:,">
  <title>{架構示範}API 服務島</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #06131e;
      color: #eaf8ff;
    }
    * { box-sizing: border-box; }
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    body { background: radial-gradient(circle at 50% 20%, #17364a 0%, #071622 48%, #030910 100%); }
    #app { position: relative; width: 100%; height: 100%; isolation: isolate; }
    #scene { position: absolute; inset: 0; z-index: 0; }
    #scene canvas { display: block; width: 100%; height: 100%; outline: none; }
    .brand {
      position: absolute; z-index: 5; top: max(18px, env(safe-area-inset-top)); left: max(20px, env(safe-area-inset-left));
      pointer-events: none; text-shadow: 0 2px 18px rgba(0,0,0,.5);
    }
    .brand__eyebrow { margin: 0 0 5px; color: #74e3ff; font-size: 11px; font-weight: 750; letter-spacing: .24em; text-transform: uppercase; }
    .brand h1 { margin: 0; font-size: clamp(20px, 3.4vw, 34px); line-height: 1; letter-spacing: -.035em; }
    .brand__phase { display: inline-block; margin-top: 9px; padding: 5px 9px; border: 1px solid rgba(126,225,255,.3); border-radius: 999px; background: rgba(5,20,31,.58); color: #c8f5ff; font-size: 11px; backdrop-filter: blur(9px); }
    .time-chip {
      position: absolute; z-index: 5; right: max(18px, env(safe-area-inset-right)); top: max(18px, env(safe-area-inset-top));
      min-width: 94px; padding: 9px 12px; border: 1px solid rgba(155,229,255,.22); border-radius: 12px;
      background: rgba(4,18,28,.58); text-align: right; pointer-events: none; backdrop-filter: blur(10px);
    }
    .time-chip small { display: block; color: #83c9dc; font-size: 9px; letter-spacing: .18em; }
    #clock { font-variant-numeric: tabular-nums; font-size: 19px; font-weight: 720; }
    #status {
      position: absolute; z-index: 20; inset: 0; display: grid; place-items: center; padding: 24px;
      background: radial-gradient(circle at 50% 45%, rgba(14,49,66,.96), rgba(3,10,16,.99)); transition: opacity .5s ease, visibility .5s ease;
    }
    #status.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    .status-card { width: min(420px, 100%); text-align: center; }
    .loader { width: 38px; height: 38px; margin: 0 auto 18px; border: 2px solid rgba(117,224,255,.2); border-top-color: #74e4ff; border-radius: 50%; animation: spin .9s linear infinite; }
    #status h2 { margin: 0 0 8px; font-size: 20px; }
    #status p { margin: 0; color: #a8c5cf; font-size: 14px; line-height: 1.65; }
    #status.is-error .loader { border-radius: 10px; border-color: #ff8e86; animation: none; transform: rotate(45deg); }
    #status.is-error h2 { color: #ffaaa4; }
    .island-label {
      transform: translate(-50%, -50%); padding: 6px 10px; border: 1px solid rgba(198,244,255,.38); border-radius: 999px;
      background: rgba(3,20,29,.74); color: #effcff; box-shadow: 0 7px 18px rgba(0,0,0,.24); font-size: 11px; font-weight: 700;
      letter-spacing: .06em; white-space: nowrap; pointer-events: none; backdrop-filter: blur(7px);
    }
    .hint { position: absolute; z-index: 5; bottom: max(16px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); color: rgba(218,245,255,.65); font-size: 11px; letter-spacing: .08em; white-space: nowrap; pointer-events: none; }
    :root { --cream:#f3e8d2; --paper:rgba(242,238,224,.88); --ink:#102b32; --teal:#45b7ac; --coral:#e77c68; --yellow:#efd36b; --stone:#8b9893; --glass:rgba(9,35,43,.72); --line:rgba(201,239,236,.24); --shadow:0 18px 50px rgba(0,13,20,.27); }
    button, input { font: inherit; }
    button { min-height:44px; border:0; cursor:pointer; }
    button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible, [tabindex]:focus-visible { outline:3px solid var(--coral); outline-offset:2px; }
    button:not(:disabled):active, button[aria-pressed="true"] { background:var(--ink); color:#f8ffff; }
    button:disabled { cursor:not-allowed; opacity:.42; }
    #ui-layer { position:absolute; z-index:8; inset:0; pointer-events:none; }
    #ui-layer > *, .help-dialog { pointer-events:auto; }
    .ui-surface { border:1px solid rgba(211,244,241,.22); background:var(--glass); box-shadow:var(--shadow); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); }
    .brand { top:max(16px,env(safe-area-inset-top)); left:max(16px,env(safe-area-inset-left)); width:min(360px,calc(100vw - 32px)); padding:18px; border-radius:18px; text-shadow:none; pointer-events:auto; }
    .brand__eyebrow, .eyebrow { display:block; margin:0 0 6px; color:#83e6ef; font:700 10px/1.2 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.18em; text-transform:uppercase; }
    .brand h1 { font-size:clamp(21px,2.8vw,31px); color:#fff; }
    .brand__subtitle { margin:6px 0 14px; color:#b8d7dc; font-size:12px; }
    .toolbar { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
    .tool-btn, .hud-btn { display:flex; min-width:0; align-items:center; justify-content:center; gap:7px; min-height:48px; padding:7px 9px; border-radius:9px; background:rgba(226,247,243,.09); color:#def4f3; transition:background .16s ease,color .16s ease,transform .16s ease; }
    .tool-btn span, .hud-btn > span { font-size:17px; line-height:1; }
    .tool-btn b, .hud-btn b { font-size:11px; font-weight:750; }
    .catalog-panel { position:absolute; top:max(16px,env(safe-area-inset-top)); right:max(16px,env(safe-area-inset-right)); bottom:116px; width:318px; padding:17px 14px; border-radius:18px; transform:translateX(calc(100% + 32px)); opacity:0; visibility:hidden; transition:transform .28s ease,opacity .28s ease,visibility .28s; overflow:hidden; }
    .catalog-panel.is-open { transform:none; opacity:1; visibility:visible; }
    .panel-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .panel-heading h2 { margin:0; font-size:20px; }
    .icon-close { width:44px; min-width:44px; padding:0; border-radius:9px; background:rgba(255,255,255,.08); color:#fff; font-size:23px; }
    .search-box { display:flex; align-items:center; gap:8px; margin:14px 0 10px; padding:0 11px; min-height:46px; border:1px solid var(--line); border-radius:12px; background:rgba(1,19,25,.48); }
    .search-box input { width:100%; border:0; outline:0; color:#fff; background:transparent; font-size:13px; }
    .search-box input::placeholder { color:#92afb4; }
    .tabs { display:grid; grid-template-columns:1fr 1fr; gap:5px; padding:4px; border-radius:12px; background:rgba(1,19,25,.4); }
    .tabs button { min-height:40px; border-radius:9px; background:transparent; color:#bcd2d4; font-size:12px; }
    .tabs button[aria-selected="true"] { background:var(--cream); color:var(--ink); }
    .catalog-content { height:calc(100% - 132px); margin-top:10px; padding-right:3px; overflow:auto; scrollbar-width:thin; }
    .domain-group { margin:0 0 8px; border:1px solid rgba(221,244,240,.14); border-radius:12px; background:rgba(1,20,26,.26); overflow:hidden; }
    .domain-group summary { display:flex; align-items:center; gap:8px; min-height:46px; padding:8px 10px; cursor:pointer; list-style:none; }
    .domain-group summary::-webkit-details-marker { display:none; }
    .domain-group summary::after { content:'+'; margin-left:auto; color:#91c3c8; }
    .domain-group[open] summary::after { content:'−'; }
    .domain-dot { width:9px; height:9px; flex:0 0 auto; border-radius:50%; background:var(--domain-color); box-shadow:0 0 0 3px color-mix(in srgb,var(--domain-color),transparent 72%); }
    .domain-select, .service-row, .flow-row { width:100%; text-align:left; color:#eaf7f6; background:transparent; }
    .domain-select { min-height:36px; padding:6px 10px; border-radius:0; color:#93cbd0; font-size:11px; }
    .service-row, .flow-row { display:grid; grid-template-columns:28px 1fr auto; align-items:center; gap:8px; min-height:48px; padding:7px 10px; border-top:1px solid rgba(221,244,240,.1); border-radius:0; }
    .service-row .node-no { display:grid; place-items:center; width:25px; height:25px; border-radius:50%; background:rgba(255,255,255,.1); font:700 10px ui-monospace,monospace; }
    .service-row small, .flow-row small { display:block; color:#8dacb0; font-size:10px; }
    .status-wrap { display:grid; justify-items:end; gap:3px; color:#b9d2d2; font-size:8px; white-space:nowrap; }.status-wrap .status-dot { position:static; }
    .status-dot { width:8px; height:8px; border-radius:50%; background:#71cba2; }
    .status-dot.warning { background:var(--yellow); }.status-dot.maintenance { background:var(--coral); }
    .flow-row { grid-template-columns:1fr auto; border:1px solid rgba(221,244,240,.12); border-radius:12px; margin-bottom:7px; }
    .flow-route { color:#b9d8d8; font-size:11px; }
    .empty-state { margin:28px 8px; padding:20px; border:1px dashed rgba(220,245,241,.25); border-radius:14px; color:#a8c2c4; text-align:center; font-size:13px; }
    .detail-panel { position:absolute; z-index:2; top:188px; left:max(16px,env(safe-area-inset-left)); bottom:116px; width:340px; padding:20px; border-radius:22px; background:rgba(243,237,218,.94); color:var(--ink); transform:translateX(calc(-100% - 32px)); opacity:0; visibility:hidden; overflow:auto; transition:transform .3s ease,opacity .3s ease,visibility .3s; }
    .detail-panel.is-open { transform:none; opacity:1; visibility:visible; }
    .detail-close { position:sticky; z-index:2; top:0; float:right; margin:-7px -7px 0 8px; background:rgba(16,43,50,.08); color:var(--ink); }
    .detail-panel .eyebrow { color:#647a77; }
    .detail-panel h2 { margin:4px 0 8px; font-size:26px; line-height:1.08; }
    .detail-panel p { color:#4d6462; font-size:13px; line-height:1.6; }
    .detail-icon { display:grid; place-items:center; width:52px; height:52px; border-radius:16px; background:var(--ink); color:var(--cream); font-size:24px; }
    .thumbnail-wrap { display:grid; place-items:center; min-height:176px; margin:10px 0 15px; border-radius:18px; background:linear-gradient(145deg,#d6e0d5,#b9cbc3); overflow:hidden; }
    .thumbnail-wrap canvas { width:160px!important; height:160px!important; }
    .metric-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; margin:13px 0; }
    .metric { min-width:0; padding:11px 7px; border-radius:12px; background:rgba(16,43,50,.08); }
    .metric strong { display:block; font:italic 20px/1 Georgia,serif; overflow:hidden; text-overflow:ellipsis; }
    .metric small { display:block; margin-top:5px; color:#617571; font-size:9px; text-transform:uppercase; }
    .node-list { display:grid; gap:6px; margin:11px 0; }
    .node-list button { display:flex; align-items:center; gap:9px; width:100%; padding:7px 10px; border-radius:9px; background:rgba(16,43,50,.07); color:var(--ink); text-align:left; }
    .chips { display:flex; flex-wrap:wrap; gap:6px; }
    .chip { display:inline-flex; align-items:center; min-height:30px; padding:5px 10px; border-radius:999px; background:rgba(69,183,172,.16); color:#245b5c; font:700 10px ui-monospace,monospace; }
    button.chip { border:1px solid rgba(34,103,102,.15); }
    .flow-hero { margin:14px 0; padding:16px; border-radius:17px; background:var(--ink); color:#effffb; }
    .flow-hero strong { display:block; margin:9px 0; font:italic 21px Georgia,serif; }
    .hud { position:absolute; left:50%; bottom:max(14px,env(safe-area-inset-bottom)); display:flex; align-items:stretch; gap:8px; max-width:calc(100vw - 28px); padding:8px; border-radius:16px; transform:translateX(-50%); overflow-x:auto; scrollbar-width:none; }
    .hud-contents { display:contents; }
    .hud::-webkit-scrollbar { display:none; }
    .hud-time { display:grid; min-width:94px; align-content:center; padding:4px 10px; border-right:1px solid var(--line); }
    .hud-time .eyebrow { margin:0; font-size:8px; }.hud-time strong { font:italic 24px/1 Georgia,serif; }.hud-time #period-name { color:#97c6ca; font-size:10px; }
    .hud-group { display:flex; gap:5px; }
    .hud-btn { flex-direction:column; min-width:58px; min-height:58px; gap:3px; padding:5px 7px; }
    .hud-btn small { max-width:62px; font-size:7px; line-height:1.1; }
    .time-btn { min-width:54px; padding:7px; border-radius:9px; background:rgba(226,247,243,.09); color:#e7f9f7; font:700 11px ui-monospace,monospace; }
    .help-dialog { width:min(440px,calc(100vw - 28px)); padding:25px; border:1px solid rgba(222,247,243,.28); border-radius:22px; color:#eaffff; }
    .help-dialog::backdrop { background:rgba(1,10,15,.64); backdrop-filter:blur(4px); }
    .help-dialog .icon-close { float:right; margin:-12px -12px 0 8px; }
    .help-dialog h2 { margin:5px 0 10px; }.help-dialog p { color:#b8d1d3; line-height:1.7; }
    .primary-btn { width:100%; margin-top:8px; border-radius:9px; background:var(--cream); color:var(--ink); font-weight:800; }
    .island-label { transition:opacity .18s ease,background .18s ease,transform .18s ease; }
    .island-label.is-selected { background:var(--ink); border-color:var(--coral); color:#fff; transform:translate(-50%,-50%) scale(1.07); }
    .island-label.is-muted { opacity:.28; }
    .island-label.is-compact { max-width:44px; overflow:hidden; text-overflow:clip; }
    .island-label.is-collision-hidden, .service-pin.is-collision-hidden { opacity:0!important; visibility:hidden; }
    .service-pin { transform:translate(-50%,-100%); display:flex; align-items:center; gap:5px; padding:4px 8px; border-radius:999px; border:1px solid rgba(255,159,137,.72); background:rgba(16,43,50,.9); color:#fff; font-size:9px; white-space:nowrap; pointer-events:none; transition:opacity .16s ease; }
    .service-pin b { color:#ffad99; font:800 10px ui-monospace,monospace; }.service-pin.is-compact span { display:none; }
    .walker-label { transform:translate(-50%,-120%); padding:5px 9px; border:1px solid rgba(255,159,137,.75); border-radius:999px; background:rgba(16,43,50,.92); color:#fff; font:700 9px/1.2 ui-monospace,monospace; white-space:nowrap; pointer-events:none; transition:opacity .16s ease; }
    .walker-label.is-overview-dot { width:9px; height:9px; padding:0; border:2px solid #fff3df; background:#f18d78; box-shadow:0 1px 5px rgba(82,58,47,.24); transform:translate(-50%,-50%); font-size:0; }
    .walker-label.is-overview-dot.is-compact { max-width:none; }.walker-label.is-overview-dot.is-compact::after { content:none; }
    .walker-label.is-compact { max-width:34px; overflow:hidden; color:transparent; }.walker-label.is-compact::after { content:'…'; position:absolute; inset:0; display:grid; place-items:center; color:#fff; }
    .walker-label.is-collision-hidden { opacity:0!important; visibility:hidden; }
    .flow-legend { position:absolute; z-index:3; right:16px; bottom:118px; display:flex; gap:7px; padding:8px 10px; border-radius:12px; font:700 9px ui-monospace,monospace; }
    .flow-legend[hidden] { display:none; }.legend-item { display:flex; align-items:center; gap:5px; }.legend-line { width:25px; height:3px; border-radius:2px; background:var(--coral); }.legend-line.async { background:repeating-linear-gradient(90deg,var(--coral) 0 10px,transparent 10px 16px); }.legend-line.pending { background:repeating-linear-gradient(90deg,var(--coral) 0 5px,transparent 5px 15px); }
    .log-panel { position:absolute; z-index:5; top:max(16px,env(safe-area-inset-top)); right:350px; width:min(360px,calc(100vw - 382px)); max-height:min(440px,calc(100vh - 136px)); padding:15px; border-radius:18px; opacity:0; visibility:hidden; transform:translateY(-12px); transition:opacity .2s ease,transform .2s ease,visibility .2s; overflow:hidden; }
    .log-panel.is-open { opacity:1; visibility:visible; transform:none; }.log-panel .panel-heading { align-items:center; }.log-title { display:flex; align-items:center; gap:8px; }.live-dot { width:8px; height:8px; border-radius:50%; background:#70d59b; box-shadow:0 0 0 4px rgba(112,213,155,.15); }.live-dot.is-paused { background:var(--yellow); box-shadow:0 0 0 4px rgba(239,211,107,.14); }
    .log-note { margin:7px 0 10px; color:#9ebfc1; font-size:10px; }.log-filter { width:100%; min-height:40px; margin-bottom:8px; padding:7px 9px; border:1px solid var(--line); border-radius:9px; background:#0b2b33; color:#efffff; }.log-list { max-height:310px; overflow:auto; scrollbar-width:thin; }.log-entry { display:grid; grid-template-columns:48px 62px 1fr; gap:6px; padding:8px 2px; border-top:1px solid rgba(221,244,240,.12); font-size:9px; line-height:1.4; }.log-entry time,.log-entry b { font-family:ui-monospace,monospace; }.log-entry b { color:#ffad99; }.log-entry span { color:#b8d3d5; }.log-empty { padding:24px 8px; color:#9ebfc1; text-align:center; font-size:11px; }
    .sheet-handle,.detail-back,.hud-toggle { display:none; }
    .sheet-handle { position:relative; width:100%; min-height:44px; padding:17px 44px 5px; border-radius:12px; background:transparent; color:inherit; font-size:10px; }
    .sheet-handle::before { content:''; position:absolute; top:9px; left:50%; width:52px; height:5px; border-radius:99px; background:currentColor; opacity:.38; transform:translateX(-50%); }
    .detail-actions { display:flex; justify-content:flex-end; gap:6px; }
    .tutorial-progress { display:flex; gap:7px; margin:16px 0; }.tutorial-progress i { width:28px; height:4px; border-radius:9px; background:rgba(255,255,255,.18); }.tutorial-progress i.is-active { background:var(--coral); }
    .tutorial-step { min-height:150px; }.tutorial-step strong { display:block; margin-bottom:8px; color:#fff; font-size:21px; }.tutorial-step p { margin:0; }
    .tutorial-actions { display:grid; grid-template-columns:auto auto 1fr; gap:7px; margin-top:16px; }.tutorial-actions button { border-radius:9px; padding:8px 12px; background:rgba(255,255,255,.09); color:#fff; }.tutorial-actions .primary-btn { width:auto; margin:0; justify-self:stretch; }
    #reload-btn { display:none; margin:18px auto 0; padding:8px 18px; border-radius:9px; background:var(--cream); color:var(--ink); font-weight:800; }
    #status.is-error #reload-btn { display:inline-flex; }
    /* Warm paper UI skin: cream surfaces, ink type, coral accents. */
    :root { --cream:#fff8f4; --paper:rgba(255,248,244,.94); --ink:#211d1d; --coral:#db6a41; --coral-dark:#a5442a; --yellow:#fcea8b; --muted:#78685e; --teal:#3e7c8c; --glass:rgba(255,248,244,.93); --line:rgba(33,29,29,.15); --shadow:0 2px 8px rgba(74,42,20,.08),0 18px 40px rgba(74,42,20,.12); color-scheme:light; color:var(--ink); background:#e9e0d4; font-family:"Noto Sans TC","PingFang TC","Microsoft JhengHei",ui-sans-serif,system-ui,sans-serif; }
    body { background:linear-gradient(180deg,#f3ece3,#d9e3df); }
    .ui-surface { border:1px solid var(--line); background:var(--glass); color:var(--ink); box-shadow:var(--shadow); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); }
    .eyebrow, .brand__eyebrow, .detail-panel .eyebrow, .hud-time .eyebrow { color:var(--coral); }
    h1, h2, .tutorial-step strong { color:var(--ink); font-weight:900; letter-spacing:-.01em; }
    .brand h1 { color:var(--ink); letter-spacing:-.02em; }
    .brand__subtitle, .log-note, .detail-panel p, .help-dialog p, .hud-time #period-name { color:var(--muted); }
    .tool-btn, .hud-btn, .time-btn, .icon-close, .tutorial-actions button, .detail-back, .detail-close { border:1px solid var(--line); border-radius:999px; background:#fffdfa; color:var(--ink); box-shadow:none; }
    .hud-btn { border-radius:16px; }.hud-btn b { white-space:nowrap; }
    .tool-btn span, .hud-btn > span { color:var(--coral); }
    @media (hover:hover) { button:not(:disabled):not([aria-pressed="true"]):hover { background:var(--yellow); color:var(--ink); } }
    button:not(:disabled):active, button[aria-pressed="true"], .tool-btn[aria-pressed="true"], .hud-btn[aria-pressed="true"] { background:var(--ink); border-color:var(--ink); color:var(--cream); }
    button[aria-pressed="true"] > span { color:var(--yellow); }
    .primary-btn, .tutorial-actions .primary-btn, #reload-btn { border:0; border-radius:12px; background:var(--ink); color:var(--cream); font-weight:800; box-shadow:0 0 0 2px var(--cream),0 0 0 4px var(--coral); }
    @media (hover:hover) { .primary-btn:not(:disabled):hover { background:var(--coral); color:#fff; } }
    .search-box, .log-filter { border:1px solid var(--line); background:#fffdfa; color:var(--ink); }
    .search-box input { color:var(--ink); }.search-box input::placeholder { color:#9a8679; }.search-box > span { color:var(--coral); }
    .tabs { background:#f2e5dc; }.tabs button { color:var(--muted); }.tabs button[aria-selected="true"] { background:var(--ink); color:var(--cream); }
    .domain-group { border:0; border-bottom:1px solid var(--line); border-radius:0; background:transparent; }
    .domain-group summary { font-weight:700; }.domain-group summary::after { color:var(--coral); }
    .domain-select, .service-row, .flow-row { color:var(--ink); }.domain-select { color:var(--coral-dark); }
    .service-row { border-top:1px solid rgba(33,29,29,.08); }.service-row .node-no { background:transparent; color:var(--coral); }
    .service-row small, .flow-row small, .flow-route, .status-wrap { color:var(--muted); }
    .flow-row { border:1px solid var(--line); background:#fffdfa; }
    .empty-state { border-color:var(--line); color:var(--muted); }
    .detail-panel { background:var(--paper); }
    .detail-icon, .flow-hero { background:var(--ink); color:var(--cream); }
    .thumbnail-wrap { background:linear-gradient(145deg,#f4ece4,#e6f1f1); }
    .metric, .node-list button { background:#fffdfa; border:1px solid var(--line); }
    .metric strong, .hud-time strong, .flow-hero strong { font:900 22px/1 "Noto Sans TC","Microsoft JhengHei",ui-sans-serif,sans-serif; font-variant-numeric:tabular-nums; letter-spacing:-.02em; }
    .metric small { color:var(--muted); }
    .chip { background:#fff1e8; color:var(--coral-dark); }button.chip { border-color:rgba(219,106,65,.28); }
    .hud { border-radius:999px; padding:7px 10px; }.hud-time { border-right-color:var(--line); }
    .time-btn { color:var(--ink); }
    .log-entry { border-top-color:var(--line); }.log-entry b { color:var(--coral); }.log-entry span { color:#3d3431; }.log-empty { color:var(--muted); }
    .flow-legend { color:var(--ink); }
    .help-dialog { color:var(--ink); }.help-dialog::backdrop { background:rgba(33,29,29,.28); backdrop-filter:blur(6px); }
    .tutorial-progress i { background:var(--line); }
    #status { background:radial-gradient(circle at 50% 45%,#fff8f4,#efe4da); color:var(--ink); }#status p { color:var(--muted); }
    .loader { border-color:rgba(219,106,65,.2); border-top-color:var(--coral); }#status.is-error h2 { color:var(--coral-dark); }#status.is-error .loader { border-color:var(--coral); }
    .island-label { border:1px solid rgba(33,29,29,.12); background:rgba(255,253,250,.94); color:var(--ink); box-shadow:0 2px 8px rgba(74,42,20,.16); font-weight:800; backdrop-filter:none; }
    .island-label.is-selected { background:var(--ink); border-color:var(--coral); color:var(--cream); }
    .service-pin, .walker-label { border-color:rgba(219,106,65,.55); background:rgba(255,253,250,.95); color:var(--ink); box-shadow:0 2px 6px rgba(74,42,20,.14); }
    .service-pin b { color:var(--coral); }.walker-label.is-compact::after { color:var(--ink); }
    .walker-label.is-overview-dot { border-color:#fff8f4; background:var(--coral); }
    @media (max-width:1100px) { .log-panel { right:16px; top:188px; width:318px; } }
    @media (max-width:900px) { .detail-panel { top:176px; } }
    @media (max-width:700px) {
      .brand { top:12px; left:12px; width:calc(100vw - 24px); padding:12px; }
      .brand__eyebrow { display:none; }.brand h1 { font-size:20px; }.brand__subtitle { margin:3px 0 8px; }
      .tool-btn { min-height:44px; }.catalog-panel,.detail-panel { z-index:4; top:120px; right:12px; bottom:92px; left:auto; width:min(318px,calc(100vw - 24px)); }
      .detail-panel { left:12px; right:auto; width:calc(100vw - 24px); }
      .hud { right:10px; left:10px; width:auto; max-width:none; transform:none; }.hud-time { min-width:82px; }
      .metric-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }.log-panel { z-index:6; top:120px; right:12px; width:calc(100vw - 24px); max-height:calc(100vh - 214px); }.flow-legend { right:12px; bottom:94px; }
    }
    @media (max-width:800px) {
      html,body,#app { height:100dvh; }
      .brand { top:max(10px,env(safe-area-inset-top)); left:max(10px,env(safe-area-inset-left)); display:flex; align-items:center; gap:8px; width:auto; max-width:calc(100vw - 20px); padding:5px 5px 5px 14px; border-radius:999px; }
      .brand__eyebrow, .brand__subtitle { display:none; }.brand h1 { flex:1 1 auto; min-width:0; overflow:hidden; font-size:15px; line-height:1.15; white-space:nowrap; text-overflow:ellipsis; }
      .toolbar { display:flex; flex:0 0 auto; gap:4px; }.tool-btn { width:44px; min-width:44px; min-height:44px; padding:0; }.tool-btn b { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
      .catalog-panel,.detail-panel { --sheet-height:52dvh; z-index:10; top:auto; right:0; bottom:0; left:0; width:100%; height:var(--sheet-height); max-height:100dvh; padding:4px 14px calc(14px + env(safe-area-inset-bottom)); border-radius:22px 22px 0 0; transform:translateY(105%); opacity:1; visibility:hidden; transition:transform .26s ease,visibility .26s; overflow:hidden; }
      .catalog-panel.is-expanded,.detail-panel.is-expanded { padding-top:calc(4px + env(safe-area-inset-top)); }
      .detail-panel { --sheet-height:34dvh; color:var(--ink); }.catalog-panel.is-open,.detail-panel.is-open { transform:none; visibility:visible; }
      .sheet-handle,.detail-back { display:block; }.detail-actions { position:relative; z-index:3; float:none; align-items:center; justify-content:space-between; margin:0 0 6px; }.detail-back { min-width:44px; padding:0 14px; border:1px solid var(--line); border-radius:999px; background:#fffdfa; color:var(--ink); font-weight:700; }
      .detail-close { position:static; float:none; margin:0; }.catalog-content { height:calc(100% - 174px); }.detail-panel #detail-content { height:calc(100% - 96px); overflow:auto; padding-bottom:12px; }
      .hud { z-index:13; right:auto; bottom:max(8px,env(safe-area-inset-bottom)); left:max(8px,env(safe-area-inset-left)); width:auto; max-width:calc(100vw - 16px); padding:5px; transform:none; overflow:hidden; }
      .hud-toggle { display:flex; flex-direction:column; min-width:66px; min-height:58px; align-items:center; justify-content:center; gap:2px; border:1px solid var(--line); border-radius:16px; background:#fffdfa; color:var(--ink); }.hud-toggle span { font-size:18px; }.hud-toggle b { font-size:10px; }
      .hud:not(.is-open) .hud-contents { display:none; }.hud.is-open { right:8px; width:calc(100vw - 16px); max-height:46dvh; flex-wrap:wrap; overflow:auto; }.hud.is-open .hud-contents { display:contents; }.hud.is-open .hud-time { display:grid; }.hud.is-open .hud-group { display:flex; }.hud.is-open .hud-toggle { position:sticky; left:0; }
      .hud-time { min-width:78px; }.hud-btn { min-width:55px; }.time-btn { min-width:51px; }
      .log-panel { z-index:14; top:auto; right:0; bottom:0; left:0; width:100%; height:min(62dvh,560px); max-height:calc(100dvh - env(safe-area-inset-top) - 10px); padding:16px 14px calc(14px + env(safe-area-inset-bottom)); border-radius:22px 22px 0 0; transform:translateY(105%); }.log-panel.is-open { transform:none; }.log-list { max-height:calc(100% - 132px); }
      .flow-legend { right:10px; bottom:calc(76px + env(safe-area-inset-bottom)); max-width:calc(100vw - 20px); flex-wrap:wrap; }
      .hud { border-radius:22px; }
      .hud, .flow-legend { transition:opacity .2s ease, visibility .2s; }
      #ui-layer.has-sheet .hud, #ui-layer.has-sheet .flow-legend { opacity:0; visibility:hidden; pointer-events:none; }
      .help-dialog { max-height:calc(100dvh - 24px); overflow:auto; padding:22px; }.tutorial-actions { grid-template-columns:1fr 1fr; }.tutorial-actions .primary-btn { grid-column:1/-1; }
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
    @media (max-width: 640px) { .brand { top: 14px; left: 14px; } .brand__phase, .hint { display: none; } .time-chip { top: 12px; right: 12px; } }
  </style>
  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
      }
    }
  </script>
</head>
<body>
  <main id="app" aria-label="API 服務島 3D 城市">
    <div id="scene"></div>
    <div id="ui-layer">
      <header class="brand ui-surface" data-ui>
        <p id="brand-eyebrow" class="brand__eyebrow">Architecture Atlas</p>
        <h1 id="brand-title">{架構示範}API 服務島</h1>
        <p class="brand__subtitle" data-i18n="subtitle" data-en="API Service Island">API 服務島</p>
        <nav class="toolbar" aria-label="城市工具列">
          <button id="overview-btn" class="tool-btn" type="button" data-i18n="overview" data-en="Overview" aria-label="返回全景"><span aria-hidden="true">◎</span><b>全景</b></button>
          <button id="list-btn" class="tool-btn" type="button" data-i18n="list" data-en="Directory" aria-label="開啟系統清單" aria-controls="catalog-panel" aria-pressed="true" aria-expanded="true"><span aria-hidden="true">☷</span><b>清單</b></button>
          <button id="help-btn" class="tool-btn" type="button" data-i18n="help" data-en="Help" aria-label="顯示操作說明"><span aria-hidden="true">?</span><b>說明</b></button>
        </nav>
      </header>

      <aside id="catalog-panel" class="catalog-panel ui-surface is-open" data-ui aria-label="系統清單">
        <button class="sheet-handle" data-sheet="catalog" type="button" aria-expanded="false" aria-label="展開系統清單">系統清單</button>
        <div class="panel-heading"><div><span class="eyebrow">SERVICE DIRECTORY</span><h2 data-i18n="cityIndex" data-en="City index">城市索引</h2></div><button class="icon-close" id="catalog-close" type="button" aria-label="關閉清單" data-en="Close">×</button></div>
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="catalog-search" type="search" autocomplete="off" placeholder="搜尋網域、服務或說明" data-en="Search domains, services, or descriptions" aria-label="搜尋網域、服務或說明"></label>
        <div class="tabs" role="tablist" aria-label="清單類型">
          <button id="domains-tab" role="tab" aria-selected="true" aria-controls="catalog-content" data-tab="domains" data-i18n="domainsTab" data-en="Domains">系統網域</button>
          <button id="flows-tab" role="tab" aria-selected="false" aria-controls="catalog-content" data-tab="flows" data-i18n="flowsTab" data-en="Call graph">呼叫關係</button>
        </div>
        <div id="catalog-content" class="catalog-content"></div>
      </aside>

      <aside id="detail-panel" class="detail-panel ui-surface" data-ui aria-live="polite" aria-label="詳細資料">
        <button class="sheet-handle" data-sheet="detail" type="button" aria-expanded="false" aria-label="展開詳細資料">詳細資料</button>
        <div class="detail-actions"><button class="detail-back" id="detail-back" type="button">← 返回清單</button><button class="icon-close detail-close" id="detail-close" type="button" aria-label="關閉詳細資料" data-en="Close">×</button></div>
        <div id="detail-content"></div>
      </aside>

      <section class="hud ui-surface" data-ui aria-label="城市控制台">
        <button id="hud-toggle" class="hud-toggle" type="button" aria-controls="city-hud-controls" aria-expanded="false"><span aria-hidden="true">◷</span><b>時間</b></button>
        <div id="city-hud-controls" class="hud-contents">
        <div class="hud-time"><span class="eyebrow" data-i18n="cityTime" data-en="City time">城市時間</span><strong id="clock">08:00</strong><span id="period-name">早晨</span></div>
        <div id="time-presets" class="hud-group" aria-label="跳至指定時間"></div>
        <div class="hud-group">
          <button id="pause-btn" class="hud-btn" type="button" aria-pressed="false"><span aria-hidden="true">Ⅱ</span><b data-i18n="pause" data-en="Pause">暫停</b></button>
          <button id="bird-btn" class="hud-btn" type="button" aria-pressed="false"><span aria-hidden="true">⌃</span><b data-i18n="bird" data-en="Bird view">鳥瞰</b></button>
        </div>
        <div class="hud-group phase4-controls" aria-label="流量模擬控制">
          <button id="labels-btn" class="hud-btn" type="button" aria-pressed="false"><span aria-hidden="true">▣</span><b data-i18n="labels" data-en="Labels">名牌</b></button>
          <button id="packets-btn" class="hud-btn" type="button" aria-pressed="true"><span aria-hidden="true">◇</span><b data-i18n="packets" data-en="Packets">封包</b></button>
          <button id="api-lines-btn" class="hud-btn" type="button" aria-pressed="false"><span aria-hidden="true">↝</span><b data-i18n="apiLines" data-en="API links">API 連線</b></button>
          <button id="logs-btn" class="hud-btn" type="button" aria-pressed="false" aria-expanded="false" aria-controls="log-panel"><span aria-hidden="true">≡</span><b data-i18n="logs" data-en="Logs">日誌</b></button>
        </div>
        </div>
      </section>
      <div id="flow-legend" class="flow-legend ui-surface" data-ui hidden aria-label="API 連線圖例"><span class="legend-item"><i class="legend-line"></i><b data-i18n="sync" data-en="Synchronous">同步</b></span><span class="legend-item"><i class="legend-line async"></i><b data-i18n="async" data-en="Asynchronous">非同步</b></span><span class="legend-item"><i class="legend-line pending"></i><b data-i18n="pending" data-en="Pending">待接通</b></span></div>
      <aside id="log-panel" class="log-panel ui-surface" data-ui aria-label="系統日誌">
        <div class="panel-heading"><div class="log-title"><i id="live-dot" class="live-dot"></i><div><span class="eyebrow" id="live-state">LIVE</span><h2 data-i18n="systemLog" data-en="System log">系統日誌</h2></div></div><button id="log-close" class="icon-close" type="button" aria-label="關閉系統日誌">×</button></div>
        <p class="log-note" data-i18n="demoTraffic" data-en="Simulated demo traffic — not production monitoring data.">示範流量，非真實監控資料。</p>
        <select id="log-filter" class="log-filter" aria-label="依資料流篩選"></select>
        <div id="log-list" class="log-list" aria-live="off"></div>
      </aside>
    </div>

    <dialog id="help-dialog" class="help-dialog ui-surface" data-ui aria-labelledby="help-title">
      <button class="icon-close" id="help-close" type="button" aria-label="關閉說明">×</button>
      <span class="eyebrow">QUICK GUIDE</span><h2 id="help-title">開始探索服務島</h2>
      <div id="tutorial-progress" class="tutorial-progress" aria-label="教學進度"><i></i><i></i><i></i></div>
      <div id="tutorial-step" class="tutorial-step" tabindex="-1"></div>
      <div class="tutorial-actions"><button id="tutorial-prev" type="button">上一步</button><button id="tutorial-skip" type="button">略過</button><button id="tutorial-next" class="primary-btn" type="button">下一步</button></div>
    </dialog>
    <section id="status" role="status" aria-live="polite">
      <div class="status-card">
        <div class="loader" aria-hidden="true"></div>
        <h2 id="status-title">正在建構服務島</h2>
        <p id="status-message">準備海面、島嶼與城市路網…</p>
        <button id="reload-btn" class="primary-btn reload-btn" type="button" hidden>重新載入</button>
      </div>
    </section>
    <noscript><section style="position:absolute;z-index:30;inset:0;display:grid;place-items:center;padding:24px;background:#fff8f4;color:#211d1d;text-align:center"><div><h2>需要啟用 JavaScript</h2><p style="color:#78685e">這座互動式 3D 城市需要 JavaScript 與 WebGL 才能運作。</p></div></section></noscript>
  </main>

  <script type="module">
    // DATA is intentionally kept at the top. Later phases will consume services, flows and models.
    const DATA = {
      city: { id: 'api-service-island', name: 'API 服務島', nameEn:'API Service Island', displayName: '{架構示範}API 服務島', displayNameEn:'{Architecture Demo} API Service Island', timezone: 'Asia/Taipei' },
      palette: {
        cream:'#eadfc8', warmCream:'#f5ead5', stone:'#aeb3a8', softStone:'#c9c9b9', darkStone:'#65716d',
        teal:'#69b9ac', darkTeal:'#347f78', coral:'#df806c', blush:'#e8b4a3', clay:'#c69778',
        leaf:'#6f956d', darkLeaf:'#4f765e', flower:'#e99ca4', trunk:'#80634f',
        window:'#b7e1d4', lamp:'#ffe4a3', cloud:'#edf1e8', ink:'#243a3b'
      },
      artDirection: {
        id:'warm-clay-toy-city', seed:928341, friendlyMainFaceChance:.36,
        density:{seed:61427, gridStep:.45, plazaScale:.55, curbScale:.79, roadClearance:.5, edgeMargin:.18, spacing:.16,
          house:{radius:.56, max:12, twoStoryChance:.35, walls:['#fff1e4','#f6e3cf','#f3dcc4','#fbefe6'], roofs:['#db6a41','#c4553a','#e0a63a','#3e7c8c','#db6a41']},
          bush:{radius:.5, max:6}, parasol:{radius:.5, max:2, canopies:['#db6a41','#fcea8b','#fff8f4']},
          lawn:{radius:1.05, max:6, colors:['#a9c47f','#9dbb74','#b6cc8a']}},
        matteRoughness:.94, glowRoughness:.78, shadowRadius:3,
        showcase:{
          domainId:'gateway', plaza:'#eee0c6', plazaInset:'#dab38f', path:'#d7b28c', curb:'#f7e9d1', cliff:'#b79b7e',
          treeClusters:[[-5.7,2.9],[0,6.15],[5.7,2.9],[-5.7,-2.9],[5.7,-2.9]],
          flowerBeds:[[-4.7,3.5],[4.7,3.5],[-4.7,-3.5],[4.7,-3.5]]
        },
        islandThemes:{
          identity:{mainArchetype:'lock', mainForm:'shield-lock', plaza:'#f2e4cd', plazaInset:'#c6a98d', path:'#ddbe9a', curb:'#faecd7', cliff:'#b9a18b', accent:'#729e93', foliage:'#71936c',
            trees:[[-5.55,3.05],[0,6.15],[5.65,2.80],[-5.75,-2.75],[5.55,-3.15]], beds:[[-4.75,3.45],[4.75,3.45],[-4.65,-3.55],[4.75,-3.45]], plazaForm:'shield'},
          order:{mainArchetype:'monolith', mainForm:'ledger-drums', plaza:'#f1e1c5', plazaInset:'#d1af85', path:'#e0bd91', curb:'#f8e9cf', cliff:'#ad9375', accent:'#698d82', foliage:'#789268',
            trees:[[-5.75,2.7],[-.55,6.12],[5.78,2.65],[-5.53,-3.10],[5.50,-3.25]], beds:[[-4.85,3.45],[4.75,3.45],[-4.80,-3.48],[4.80,-3.48]], plazaForm:'ledger'},
          payment:{mainArchetype:'monolith', mainForm:'cipher-vault', plaza:'#eee1cf', plazaInset:'#d2b09a', path:'#d6b39c', curb:'#f7e9d7', cliff:'#ad9483', accent:'#688f8c', foliage:'#738e70',
            trees:[[-5.80,2.85],[0,6.12],[5.75,2.90],[-5.65,-2.98],[5.70,-3.05]], beds:[[-4.70,3.50],[4.70,3.50],[-4.75,-3.55],[4.75,-3.50]], plazaForm:'cipher'},
          customer:{mainArchetype:'server-array', mainForm:'customer-hall', plaza:'#f2e6d3', plazaInset:'#d7bca0', path:'#ddc1a2', curb:'#faeedb', cliff:'#b8a28b', accent:'#6f9b91', foliage:'#7c9b72', treeForm:'puff', nearCabinets:true,
            trees:[[-6.05,2.10],[-2.25,5.75],[4.95,3.55],[-5.60,-3.30],[5.78,-2.85]], beds:[[-4.65,3.75],[4.88,3.35],[-4.75,-3.60],[4.70,-3.60]], plazaForm:'courtyard'},
          catalog:{mainArchetype:'monolith', mainForm:'market-shelves', plaza:'#f2deb9', plazaInset:'#dbbd91', path:'#e4c59b', curb:'#faecd3', cliff:'#b7a082', accent:'#8a9a70', foliage:'#8a9f70', treeForm:'layered', nearCabinets:true,
            trees:[[-5.65,2.60],[-.50,6.25],[5.90,2.55],[-5.80,-2.75],[5.38,-3.30]], beds:[[-4.85,3.35],[4.60,3.60],[-4.65,-3.70],[4.80,-3.35]], plazaForm:'market'},
          traffic:{mainArchetype:'server-array', mainForm:'storage-bins', plaza:'#e9e1c6', plazaInset:'#cdbb97', path:'#d8c6a5', curb:'#f7eed9', cliff:'#a8a08a', accent:'#819b78', foliage:'#829d70', treeForm:'layered', nearCabinets:true,
            trees:[[-5.85,2.50],[.85,6.05],[5.80,2.65],[-5.35,-3.35],[5.70,-3.00]], beds:[[-4.70,3.50],[4.75,3.45],[-4.80,-3.40],[4.65,-3.60]], plazaForm:'stock'},
          registry:{mainArchetype:'adapter', mainForm:'dispatch-post', plaza:'#f0e0ca', plazaInset:'#d2b79b', path:'#e0bea0', curb:'#f9ebd8', cliff:'#bba08b', accent:'#7199a0', foliage:'#739177', treeForm:'puff', nearCabinets:true,
            trees:[[-5.70,2.85],[-1.05,6.05],[5.83,2.65],[-5.65,-3.10],[5.45,-3.35]], beds:[[-4.80,3.45],[4.65,3.60],[-4.55,-3.65],[4.85,-3.35]], plazaForm:'route'},
          notification:{mainArchetype:'message-queue', mainForm:'message-bell', plaza:'#f0dcda', plazaInset:'#d6b3a7', path:'#dfbea9', curb:'#faeadd', cliff:'#b39b96', accent:'#a08ba8', foliage:'#78916e', treeForm:'rounded', nearCabinets:true,
            trees:[[-5.88,2.60],[.55,6.14],[5.72,2.98],[-5.65,-3.12],[5.50,-3.18]], beds:[[-4.75,3.55],[4.80,3.42],[-4.70,-3.55],[4.65,-3.58]], plazaForm:'message'},
          analytics:{mainArchetype:'database', mainForm:'data-observatory', plaza:'#e9dfdf', plazaInset:'#cdb7a1', path:'#d9c1ac', curb:'#f7eddf', cliff:'#aaa094', accent:'#8a91ad', foliage:'#728d7a', treeForm:'rounded', nearCabinets:true,
