      function createServiceLamps(){serviceLampIds=[...new Set(DATA.flows.flatMap(flow=>[flow.from,flow.to]))];const geometry=new THREE.SphereGeometry(.085,10,8),material=new THREE.MeshBasicMaterial({color:0xffffff,toneMapped:false,transparent:true,opacity:.8,depthWrite:false});serviceLampMesh=new THREE.InstancedMesh(geometry,material,serviceLampIds.length);const lookup=new Map(),matrix=new THREE.Matrix4(),base=new THREE.Color('#6d5a40');serviceLampIds.forEach((id,index)=>{const position=servicePositions.get(id);matrix.makeTranslation(position.x,position.y+.60,position.z+.68);serviceLampMesh.setMatrixAt(index,matrix);serviceLampMesh.setColorAt(index,base);lookup.set(index,id);arrivalPulse.set(id,0);});serviceLampMesh.instanceMatrix.needsUpdate=true;serviceLampMesh.instanceColor.needsUpdate=true;serviceLampMesh.castShadow=false;serviceLampMesh.receiveShadow=false;instanceLookup.set(serviceLampMesh,lookup);selectableServiceMeshes.push(serviceLampMesh);scene.add(serviceLampMesh);}
      const lampLow=new THREE.Color('#6d5a40'),lampBright=new THREE.Color('#ffdfaa'),lampColor=new THREE.Color();
      function updateServiceActivity(delta){if(!serviceLampMesh)return;serviceLampIds.forEach((id,index)=>{const pulse=Math.max(0,(arrivalPulse.get(id)||0)-delta);arrivalPulse.set(id,pulse);const breathe=currentHighLoad.has(id) ? .09+.035*Math.sin(flowPatternTime*.82+index) : 0;lampColor.copy(lampLow).lerp(lampBright,THREE.MathUtils.clamp(pulse/DATA.stage4.traffic.arrivalFlash+breathe,0,1));serviceLampMesh.setColorAt(index,lampColor);});serviceLampMesh.instanceColor.needsUpdate=true;}
      function createWalkers(){
        const stageRng=mulberry32(DATA.stage4.seed),validFlows=DATA.flows.filter(flow=>flowRoutes.has(flow.id));let index=0;validFlows.forEach((flow,flowIndex)=>{const route=flowRoutes.get(flow.id),pool=[];flowRuntime.set(flow.id,{flow,walkers:pool,load:0,target:0,launchTimer:0,burstLeft:0,burstIndex:0});for(let i=0;i<flow.walkers;i++){const id=`${flow.id}-packet-${String(i+1).padStart(2,'0')}`,direction=1,distance=0;const walker={id,flow,route,index:index++,phase:stageRng(),state:'idle',direction,distance,wait:0,active:false,queueEndpoint:null,queueSlot:-1,position:new THREE.Vector3(),heading:new THREE.Vector3(0,0,1),accessory:flow.accessory};pool.push(walker);walkers.push(walker);walkerById.set(id,walker);const sprite=new THREE.Sprite(getBadgeResource(flow.badge).material);sprite.scale.set(.34,.34,1);sprite.renderOrder=40;scene.add(sprite);walker.badge=sprite;const element=document.createElement('div');element.className='walker-label';element.textContent=`${tr('transmitting')} ${localize(flow,'payload')}`;element.dataset.full=element.textContent;const labelObject=new CSS2DObject(element);scene.add(labelObject);walker.label={element,object:labelObject};walkerLabels.set(id,walker.label);}});
