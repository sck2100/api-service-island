      function focusIsland(domain){const target=islandById.get(domain.id).center.clone();target.y=.6;flyCamera(target,new THREE.Vector3(...DATA.stage3.camera.islandOffset));}
      function focusService(serviceId){const target=servicePositions.get(serviceId).clone();target.y=1;flyCamera(target,new THREE.Vector3(...DATA.stage3.camera.serviceOffset));}
      function focusFlow(flow){const a=servicePositions.get(flow.from),b=servicePositions.get(flow.to);if(!a||!b)return;const target=a.clone().add(b).multiplyScalar(.5),span=a.distanceTo(b);flyCamera(target,new THREE.Vector3(Math.max(3,span*.18),Math.max(5,span*.36),Math.max(7,span*.72)));}
      function focusWalker(walker){const target=walker.position.clone();flyCamera(target,new THREE.Vector3(1.5,2.2,3));}
      function flyCamera(rawTarget,offset){leaveBirdView();const target=rawTarget.clone();if(ui.detail.classList.contains('is-open')&&!isMobileLayout())target.x+=DATA.stage3.camera.panelTargetShift;const destination=rawTarget.clone().add(offset);startFlight(destination,target);}
      function startFlight(position,target){cameraFlight=null;if(reducedMotion){camera.position.copy(position);controls.target.copy(target);controls.update();return;}cameraFlight={start:performance.now(),duration:DATA.stage3.camera.duration,fromPosition:camera.position.clone(),toPosition:position.clone(),fromTarget:controls.target.clone(),toTarget:target.clone()};}
      function updateCameraFlight(now){if(!cameraFlight)return;const t=Math.min(1,(now-cameraFlight.start)/cameraFlight.duration),e=t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;camera.position.lerpVectors(cameraFlight.fromPosition,cameraFlight.toPosition,e);controls.target.lerpVectors(cameraFlight.fromTarget,cameraFlight.toTarget,e);if(t>=1)cameraFlight=null;}
      function cancelCameraFlight(){cameraFlight=null;}
      function focusOverview(){leaveBirdView();const target=new THREE.Vector3(...DATA.stage3.overview.target),distance=camera.aspect<.9?DATA.stage3.overview.narrowDistance:DATA.stage3.overview.wideDistance;startFlight(target.clone().addScaledVector(overviewDirection,distance),target);}
      function setBirdView(enabled){birdView=enabled;ui.bird.setAttribute('aria-pressed',String(enabled));cancelCameraFlight();if(enabled){controls.maxPolarAngle=Math.PI;const target=controls.target.clone(),position=target.clone().add(new THREE.Vector3(...DATA.stage3.camera.birdOffset));startFlight(position,target);}else{controls.maxPolarAngle=defaultMaxPolarAngle;focusOverview();}}
