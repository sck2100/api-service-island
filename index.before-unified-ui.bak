      function drawBadgeIcon(context,type){context.clearRect(0,0,128,128);context.fillStyle='#fff';context.beginPath();context.arc(64,64,54,0,Math.PI*2);context.fill();context.strokeStyle=DATA.palette.coral;context.lineWidth=8;context.stroke();context.strokeStyle='#102b32';context.fillStyle='#102b32';context.lineWidth=7;context.lineCap='round';context.lineJoin='round';if(type==='key'){context.beginPath();context.arc(49,58,13,0,Math.PI*2);context.stroke();context.beginPath();context.moveTo(59,68);context.lineTo(84,91);context.moveTo(73,80);context.lineTo(81,72);context.stroke();}else if(type==='lock'){context.strokeRect(39,57,50,39);context.beginPath();context.arc(64,57,18,Math.PI,0);context.stroke();context.beginPath();context.arc(64,75,4,0,Math.PI*2);context.fill();}else{context.strokeRect(39,31,50,67);context.beginPath();context.moveTo(49,51);context.lineTo(78,51);context.moveTo(49,65);context.lineTo(78,65);context.moveTo(49,79);context.lineTo(69,79);context.stroke();}}
